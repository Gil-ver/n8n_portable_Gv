                                           Text="🔲"
                                           Width="24"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                                <ContentPresenter Margin="4,0,0,0"
                                                  VerticalAlignment="Center"
