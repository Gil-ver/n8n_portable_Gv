                        <!--
                            控制标题：PS 字号 24px → 16 DIP；左对齐磁贴 2；距磁贴 2 顶边 12px → 8 DIP。
                            标题行高按 16 DIP 固定，因此 Canvas.Top = 198.66 - 8 - 16 = 174.66 DIP。
                        -->
                        <TextBlock x:Name="ControlsTitleText"
                                   Canvas.Left="48"
                                   Canvas.Top="170"
                                   Height="20"
                                   Text="控制 (Controls)"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   LineHeight="20"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="#0080ff"/>

                        <!--
                            启动页磁贴 2：PS 设计稿 740px × 586px，左对齐磁贴 1，位于磁贴 1 下方且间距 80px。
                            150% DPI 换算：493.33 × 390.67 DIP；Canvas.Top = 25.33 + 120 + (80 / 1.5) = 198.66 DIP。
                        -->
                        <Border x:Name="LaunchTile02"
                                Canvas.Left="48"
                                Canvas.Top="198"
                                Width="493.33"
                                Height="390.67"
                                Background="{DynamicResource LaunchActionTileBackgroundBrush}"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonUp="LaunchTile02_MouseLeftButtonUp"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="LaunchTile02ClipRoot"
                                  ClipToBounds="True">

                                <Canvas x:Name="LaunchStarLayer"
                                        ClipToBounds="True"
                                        IsHitTestVisible="False"/>

                                <!--
                                    星球 planet_1.svg（带星环星球）：z 序在星星之上、流星之下，深空背景装饰。
                                    素材 viewBox 1768.92×772.99（长宽比 ≈2.288）。
                                    用户口径：画板左下角为坐标原点(0,0)，右上角为(740,586)，X 向右，Y 向上；PS px ÷1.5=DIP。
                                    尺寸 180×80 PS → 120×53.33 DIP；位置 x=584,y=470 PS 表示图标中心 → Left=(584-90)/1.5=329.33, Top=(586-(470+40))/1.5=50.67 DIP。
                                    未运行时通过 LaunchPlanet1EntryTransform 藏在右上方画板外；启动后沿右上方 30° 斜线进入当前位置。
                                    顺时针旋转 15°（RotateTransform，绕自身中心 RenderTransformOrigin=0.5,0.5）。
                                    承载层 ClipToBounds=True 将星球限制在画板内；不参与命中测试。
                                -->
                                <Canvas x:Name="LaunchPlanet1Layer"
                                        ClipToBounds="True"
                                        IsHitTestVisible="False">
                                    <Image x:Name="LaunchPlanet1"
                                           Canvas.Left="329.33"
                                           Canvas.Top="50.67"
                                           Width="120"
                                           Height="53.33"
                                           Source="{StaticResource LaunchPlanet1Image}"
                                           Stretch="Fill"
                                           IsHitTestVisible="False"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform x:Name="LaunchPlanet1EntryTransform" X="180" Y="-103.92"/>
                                                <RotateTransform Angle="15"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>

                                <!--
                                    星球 planet_3.svg：z 序在流星下面一层。
                                    用户口径：画板左下角为坐标原点(0,0)，右上角为(740,586)，X 向右，Y 向上；PS px ÷1.5=DIP。
                                    尺寸 50×50 PS → 33.33×33.33 DIP；位置 x=256,y=520 PS 表示图标中心 → Left=(256-25)/1.5=154, Top=(586-(520+25))/1.5=27.33 DIP。
                                    未运行时通过 LaunchPlanet3EntryTransform 藏在左上方画板外；启动后沿左侧 84° 接近垂直向下进入当前位置。
                                -->
                                <Canvas x:Name="LaunchPlanet3Layer"
                                        ClipToBounds="True"
                                        IsHitTestVisible="False">
                                    <Image x:Name="LaunchPlanet3"
                                           Canvas.Left="154"
                                           Canvas.Top="27.33"
                                           Width="33.33"
                                           Height="33.33"
                                           Source="{StaticResource LaunchPlanet3Image}"
                                           Stretch="Fill"
                                           IsHitTestVisible="False"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TranslateTransform x:Name="LaunchPlanet3EntryTransform" X="-16.82" Y="-160"/>
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>

                                <!--
                                    流星承载层：独立于星星层，z 序在星星之上、火箭之下。
                                    流星元素均限制在画板内（ClipToBounds），不参与命中测试。
                                -->
                                <Canvas x:Name="LaunchMeteorLayer"
                                        ClipToBounds="True"
                                        IsHitTestVisible="False"/>

                                <!--
                                    星球 planet_2.svg：z 序在流星之上。
                                    用户口径：画板左下角为坐标原点(0,0)，右上角为(740,586)，X 向右，Y 向上；PS px ÷1.5=DIP。
                                    尺寸 80×80 PS → 53.33×53.33 DIP；位置 x=128,y=420 PS 表示图标中心 → Left=(128-40)/1.5=58.67, Top=(586-(420+40))/1.5=84 DIP。
                                    未运行时通过 LaunchPlanet2EntryTransform 藏在左侧画板外；启动后沿左侧 24° 斜线进入当前位置。
                                -->
                                <Canvas x:Name="LaunchPlanet2Layer"
                                        ClipToBounds="True"
                                        IsHitTestVisible="False">
                                    <Image x:Name="LaunchPlanet2"
                                           Canvas.Left="58.67"
                                           Canvas.Top="84"
                                           Width="53.33"
                                           Height="53.33"
                                           Source="{StaticResource LaunchPlanet2Image}"
                                           Stretch="Fill"
                                           IsHitTestVisible="False"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TranslateTransform x:Name="LaunchPlanet2EntryTransform" X="-120" Y="-53.42"/>
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>

                                <!--
                                    云朵承载层 LaunchCloudLayer：z 序在星星/流星之上、火箭组件（火箭/火焰/烟雾）之下。
                                    三层云尺寸完全相同：宽 = 画板 493.33 × 1.1 = 542.66 DIP，等比（viewBox 比 ≈1.3144）→ 高 412.85 DIP；
                                    X 轴在画板居中：Left = (493.33 − 542.66) / 2 = −24.665 DIP；
                                    底部中心对齐：三层同一 Top；最终位置云顶到画板 2/3 高处（Top=390.67/3≈130.22），底部伸出画板被静态窗口遮住。
                                    尺寸不做缩放区分，仅“晃动幅度/移动速度”按 底层1.4 / 中层1.2 / 顶层1.0 倍数递增（见 cs 动画）。
                                    本层 ClipToBounds=False（云随动画移动，完整存在），裁切只在不动的父层 LaunchTile02ClipRoot。
                                    每层预留两个 TranslateTransform：Rise（入场上移，初始藏画板下方）+ Sway（棉花糖横向晃动）。
                                    初始 RiseY=0（第3步静态停最终位置便于验证尺寸；入场藏底/动画由 cs 控制）。
                                -->
                                <Canvas x:Name="LaunchCloudLayer"
                                        ClipToBounds="False"
                                        IsHitTestVisible="False">
                                    <!--
                                        圆角显示窗口：Border.CornerRadius 只裁 Border 自身背景、不裁子元素，
                                        而 ClipToBounds 给出的裁剪框是纯矩形（无圆角信息）。云升到位后铺满并向下溢出画板，
                                        近白色云会把左下/右下的 8 DIP 圆角缺口填成白色直角。
                                        故在本层（不动、无 RenderTransform）设与画板同尺寸同圆角的 Clip 作为固定显示窗口；
                                        动画只作用于子 Image 的 RenderTransform，裁剪框不随之位移。
                                    -->
                                    <Canvas.Clip>
                                        <RectangleGeometry Rect="0,0,493.33,390.67" RadiusX="8" RadiusY="8"/>
                                    </Canvas.Clip>
                                    <!-- 底层（最深 #B3D5F8，晃动幅度/速度系数 1.4） -->
                                    <Image x:Name="LaunchCloudBack"
                                           Canvas.Left="-24.665"
                                           Canvas.Top="130.22"
                                           Width="542.66"
                                           Height="412.85"
                                            Source="{StaticResource LaunchCloudBackLight}"
                                           Stretch="Fill"
                                           IsHitTestVisible="False">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform x:Name="LaunchCloudBackRise" Y="412.85"/>
                                                <TranslateTransform x:Name="LaunchCloudBackSway"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>

                                <!--
                                    火箭组件承载层 LaunchRocketAssembly：铺满画板的 Canvas，z 序在底层云之上、中层云之下。
                                    火箭与火焰均为其子元素，使用画板坐标系绝对定位；对本容器施加的动画两者一同跟随，
                                    从而实现"火焰绑定在火箭上"。

                                    ★裁切归属：本层带 RenderTransform 会随火箭移动，绝不可在此设 ClipToBounds，
                                    否则裁切框会跟着位移、把元素裁成固定形状再整体平移。裁切只放在不动的父层
                                    LaunchTile02ClipRoot（固定等于画板，充当显示窗口）。本层 ClipToBounds=False，
                                    使烟雾/火箭/火焰完整存在并移动，由固定的画板窗口实时显示其落入画板内的部分。
                                -->
                                <Canvas x:Name="LaunchRocketAssembly"
                                        ClipToBounds="False"
                                        IsHitTestVisible="False">
                                    <!--
                                        火箭组件整体初始上移 50px 设计稿距离：50 / 1.5 = 33.33 DIP。
                                        启动后不再做火箭位移动画；火箭、火焰、烟雾保持同一静态上移位置。
                                    -->
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="LaunchRocketFloatTransform" Y="-33.33"/>
                                            <TranslateTransform x:Name="LaunchRocketShakeTransform"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <!--
                                        尾气烟雾 smoke.svg：原 viewBox 962.15×1868.06（细长，3 层 polygon）。
                                        基准布局框：宽 50 DIP、高 120 DIP（与火焰同源比例）；
                                        再以顶部中心(0.5,0)为锚点 ScaleTransform 等比 2 倍放大 → 视觉等比放大，不引入额外形变。
                                        画板与火箭组件层均保留 ClipToBounds（剪切蒙版）：烟雾完整存在、随火箭移动，
                                        探出画板的尾气尖端被画板边界遮住不显示，元素仅在画板内可见。
                                        Top=317.34 接近火焰原点向下延伸，底部超出画板底边(390.67)被裁，留足余量。
                                        水平位置(Left)缩放完成后再单独校准，使出气口尖端对齐火焰原点 X=246.67。
                                        颜色改为黑色；3 层各自做随机透明度变动；点火后容器整体缓现，熄灭时淡出。
                                        z 序最底（先声明=底层，在火焰与火箭之下）。初始 Opacity=0 等待点火驱动。
                                    -->
                                    <Viewbox x:Name="LaunchSmoke"
                                             Canvas.Left="230.01"
                                             Canvas.Top="297.34"
                                             Width="50"
                                             Height="120"
                                             Stretch="Fill"
                                             Opacity="0"
                                             IsHitTestVisible="False"
                                             RenderTransformOrigin="0.5,0">
                                        <Viewbox.RenderTransform>
                                            <ScaleTransform ScaleX="2" ScaleY="2"/>
                                        </Viewbox.RenderTransform>
                                        <Canvas Width="962.15" Height="1868.06">
                                            <Path x:Name="LaunchSmokeLayer1" Fill="Black" Opacity="0.2"
                                                  Data="M 353.24,39.02 L 0,1868.06 L 747.97,1868.06 L 433.21,0 Z"/>
                                            <Path x:Name="LaunchSmokeLayer2" Fill="Black" Opacity="0.2"
                                                  Data="M 747.97,1868.06 L 445.45,72.57 L 414.16,87.81 L 70.43,1868.06 Z"/>
                                            <Path x:Name="LaunchSmokeLayer3" Fill="Black" Opacity="0.2"
                                                  Data="M 962.15,1868.06 L 448.72,130.62 L 417.85,151.04 L 313.9,1868.06 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <!--
                                        火焰 fire.svg：PS 72×84 → 48×56 DIP。
                                        顶部中心点：在"从画板底边往上 70px"基础上先上移 50 PS、再下移 10 PS，净上移 40 PS（26.67 DIP）。
                                        Top = 344 - 50/1.5 + 10/1.5 = 317.34 DIP；左上角 Left=246.67-24=222.67。
                                        缩放原点设为顶部中心（RenderTransformOrigin=0.5,0），点火/燃烧从顶部中心展开。
                                        z 序在火箭之下（先声明=底层），喷口喷出、火焰根部被箭体遮住。
                                        初始隐藏：Opacity=0 且 Scale=0，等待点火动画驱动。
                                    -->
                                    <Image x:Name="LaunchFire"
                                           Canvas.Left="222.67"
                                           Canvas.Top="317.34"
                                           Width="48"
                                           Height="56"
                                           Source="{StaticResource LaunchFireImage}"
                                           Stretch="Fill"
                                           Opacity="0"
                                           RenderTransformOrigin="0.5,0"
                                           IsHitTestVisible="False">
                                        <Image.RenderTransform>
                                            <ScaleTransform x:Name="LaunchFireScale" ScaleX="0" ScaleY="0"/>
                                        </Image.RenderTransform>
                                    </Image>

                                    <!--
                                        火箭 rocket.svg：PS 设计稿 230×340，原距画板底部 100px，组件层已整体上移 50px。
                                        150% DPI 换算：153.33 × 226.67 DIP；原底距 100 / 1.5 = 66.67 DIP。
                                        等价绝对坐标：Left=(493.33-153.33)/2=170；Top=390.67-66.67-226.67=97.33。
                                    -->
                                    <Image x:Name="LaunchRocket"
                                           Canvas.Left="170"
                                           Canvas.Top="97.33"
                                           Width="153.33"
                                           Height="226.67"
                                           Source="{StaticResource LaunchRocketImage}"
                                           Stretch="Fill"
                                           IsHitTestVisible="False"/>
                                </Canvas>

                                <!-- 中层云 + 顶层云（火箭组件之上） -->
                                <Canvas x:Name="LaunchCloudLayerTop"
                                        ClipToBounds="False"
                                        IsHitTestVisible="False">
                                    <!-- 圆角显示窗口：同 LaunchCloudLayer，避免中/顶层云溢出磁贴圆角形成白色直角。 -->
                                    <Canvas.Clip>
                                        <RectangleGeometry Rect="0,0,493.33,390.67" RadiusX="8" RadiusY="8"/>
                                    </Canvas.Clip>
                                    <!-- 中层（#DBECFC，系数 1.2） -->
                                    <Image x:Name="LaunchCloudMid"
                                           Canvas.Left="-24.665"
                                           Canvas.Top="130.22"
                                           Width="542.66"
                                           Height="412.85"
                                            Source="{StaticResource LaunchCloudMidLight}"
                                           Stretch="Fill"
                                           IsHitTestVisible="False">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform x:Name="LaunchCloudMidRise" Y="412.85"/>
                                                <TranslateTransform x:Name="LaunchCloudMidSway"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- 顶层（最亮 #F0F7FC，系数 1.0） -->
                                    <Image x:Name="LaunchCloudFront"
                                           Canvas.Left="-24.665"
                                           Canvas.Top="130.22"
                                           Width="542.66"
                                           Height="412.85"
                                            Source="{StaticResource LaunchCloudFrontLight}"
                                           Stretch="Fill"
                                           IsHitTestVisible="False">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform x:Name="LaunchCloudFrontRise" Y="412.85"/>
                                                <TranslateTransform x:Name="LaunchCloudFrontSway"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>

                                <Grid Margin="34,30,34,28">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="74"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="220"
                                          Height="220"/>

                                    <!-- 后台状态文字保留为隐藏控件，用于现有状态更新逻辑；按钮可见标题由下方固定 TextBlock 承担。 -->
                                    <StackPanel Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="LaunchTile02TitleText"
                                                   Text="开始运行 (Start)"
                                                   HorizontalAlignment="Center"
                                                   FontSize="28"
                                                   FontWeight="Normal"
                                                   Foreground="Black"/>
                                        <TextBlock x:Name="LaunchTile02StatusText"
                                                   Text="Start n8n"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="#B3000000"/>
                                    </StackPanel>
                                </Grid>

                                <!-- PS 文字字号 36px → 24 DIP；距按钮底部 30px → 20 DIP。 -->
                                <TextBlock x:Name="LaunchTile02ActionText"
                                           Text="开始运行 (Start)"
                                           Height="24"
                                           Margin="0,0,0,20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource LaunchActionTileTextBrush}"
                                           LineHeight="24"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextAlignment="Center"
                                           IsHitTestVisible="False"/>

                                <!-- PNG 颜色层（顶层）：通过父 Border.Clip 环形几何剪切成 6 DIP 描边形状。
                                     Opacity 由 C# UpdateGradientRingVisibility() 统一控制（未运行常显；运行时鼠标悬浮 Tile03/04 时隐藏）。 -->
                                <Border x:Name="LaunchTile02GradientRing" CornerRadius="8" IsHitTestVisible="False">
                                    <Border.Clip>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="0,0,493.33,390.67" RadiusX="8" RadiusY="8"/>
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <RectangleGeometry Rect="6,6,481.33,378.67" RadiusX="4" RadiusY="4"/>
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Border.Clip>
                                    <Canvas>
                                        <Image x:Name="LaunchTile02GradientImage"
                                               Source="pack://application:,,,/icon/launch/渐变色.png"
                                               Stretch="Uniform"
                                               Width="780"
                                               Height="780"
                                               Canvas.Left="-143"
                                               Canvas.Top="-195"
                                               RenderTransformOrigin="0.5,0.5"
                                               IsHitTestVisible="False">
                                            <Image.RenderTransform>
                                                <RotateTransform x:Name="LaunchTile02GradientRotation" Angle="0"/>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Canvas>
                                </Border>

                            </Grid>
                        </Border>

                        <!--
                            启动页磁贴 3：PS 设计稿 276px × 277px，位于磁贴 2 右侧，距磁贴 2 右边 32px，顶部对齐磁贴 2。
                            150% DPI 换算：184 × 184.67 DIP；Canvas.Left = 48 + 493.33 + (32 / 1.5) = 562.66 DIP。
                        -->
                        <Border x:Name="LaunchTile03"
                                Canvas.Left="562.66"
                                Canvas.Top="198"
                                Width="184"
                                Height="184.67"
                                Background="{DynamicResource LaunchActionTileBackgroundBrush}"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonUp="LaunchTile03_MouseLeftButtonUp"
                                MouseEnter="LaunchTile03_MouseEnter"
                                MouseLeave="LaunchTile03_MouseLeave"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Image x:Name="StopLaunchTileImage"
                                       Width="184"
                                       Height="184.67"
                                       Source="icon/launch/Stop.png"
                                       Stretch="Fill"
                                       SnapsToDevicePixels="True"/>
                                <Image x:Name="StopLaunchTileGrayscaleImage"
                                       Width="184"
                                       Height="184.67"
                                       Stretch="Fill"
                                       Opacity="0"
                                       SnapsToDevicePixels="True"/>
                                <!-- PS 文字字号 24px → 16 DIP；距按钮底部 20px → 13.33 DIP。 -->
                                <TextBlock Text="停止运行 (Stop)"
                                           Height="16"
                                           Margin="0,0,0,13.33"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource LaunchActionTileTextBrush}"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextAlignment="Center"/>

                                <!-- PNG 颜色层（顶层）：通过父 Border.Clip 环形几何剪切成 6 DIP 描边形状；
                                     PNG 中心 (390, 390) 对齐按钮中心 (92, 92.335)：Left=-298 / Top=-297.665；
                                     旋转 Angle 绑定到 LaunchTile02GradientRotation，与"开始运行"按钮同步同角度旋转。
                                     初始 Opacity=0；运行态鼠标悬浮 Tile03 时由 C# 置为 1。 -->
                                <Border x:Name="LaunchTile03GradientRing" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                                    <Border.Clip>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="0,0,184,184.67" RadiusX="8" RadiusY="8"/>
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <RectangleGeometry Rect="6,6,172,172.67" RadiusX="4" RadiusY="4"/>
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Border.Clip>
                                    <Canvas>
                                        <Image Source="pack://application:,,,/icon/launch/渐变色.png"
                                               Stretch="Uniform"
                                               Width="780"
                                               Height="780"
                                               Canvas.Left="-298"
                                               Canvas.Top="-297.665"
                                               RenderTransformOrigin="0.5,0.5"
                                               IsHitTestVisible="False">
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle, ElementName=LaunchTile02GradientRotation, Mode=OneWay}"/>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Canvas>
                                </Border>
                            </Grid>
                        </Border>

                        <!--
                            启动页磁贴 4：PS 设计稿 276px × 277px，位于磁贴 3 下方，间距 32px。
                            150% DPI 换算：184 × 184.67 DIP；Canvas.Top = 198.66 + 184.67 + (32 / 1.5) = 404.66 DIP。
                        -->
                        <Border x:Name="LaunchTile04"
                                Canvas.Left="562.66"
                                Canvas.Top="404"
                                Width="184"
                                Height="184.67"
                                Background="{DynamicResource LaunchActionTileBackgroundBrush}"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonUp="LaunchTile04_MouseLeftButtonUp"
                                MouseEnter="LaunchTile04_MouseEnter"
                                MouseLeave="LaunchTile04_MouseLeave"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Image x:Name="RestartLaunchTileImage"
                                       Width="184"
                                       Height="184.67"
                                       Source="icon/launch/restart.png"
                                       Stretch="Fill"
                                       SnapsToDevicePixels="True"/>
                                <Image x:Name="RestartLaunchTileGrayscaleImage"
                                       Width="184"
                                       Height="184.67"
                                       Stretch="Fill"
                                       Opacity="0"
                                       SnapsToDevicePixels="True"/>
                                <!-- PS 文字字号 24px → 16 DIP；距按钮底部 20px → 13.33 DIP。 -->
                                <TextBlock Text="重新启动 (Restart)"
                                           Height="16"
                                           Margin="0,0,0,13.33"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource LaunchActionTileTextBrush}"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextAlignment="Center"/>

                                <!-- PNG 颜色层（顶层）：通过父 Border.Clip 环形几何剪切成 6 DIP 描边形状；
                                     PNG 中心 (390, 390) 对齐按钮中心 (92, 92.335)：Left=-298 / Top=-297.665；
                                     旋转 Angle 绑定到 LaunchTile02GradientRotation，与"开始运行"/"停止运行"按钮同步同角度旋转。
                                     初始 Opacity=0；运行态鼠标悬浮 Tile04 时由 C# 置为 1。 -->
                                <Border x:Name="LaunchTile04GradientRing" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                                    <Border.Clip>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="0,0,184,184.67" RadiusX="8" RadiusY="8"/>
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <RectangleGeometry Rect="6,6,172,172.67" RadiusX="4" RadiusY="4"/>
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Border.Clip>
                                    <Canvas>
                                        <Image Source="pack://application:,,,/icon/launch/渐变色.png"
                                               Stretch="Uniform"
                                               Width="780"
                                               Height="780"
                                               Canvas.Left="-298"
                                               Canvas.Top="-297.665"
                                               RenderTransformOrigin="0.5,0.5"
                                               IsHitTestVisible="False">
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle, ElementName=LaunchTile02GradientRotation, Mode=OneWay}"/>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Canvas>
                                </Border>
                            </Grid>
                        </Border>

                        <!--
                            Tile03↔Tile04 垂直缝隙的透明桥接层：
                            · Tile03 底边 Y = 198 + 184.67 = 382.67；Tile04 顶边 Y = 404；
                              缝隙 Rect = (562.66, 382.67, 184, 21.33)。
                            · 用途：鼠标从 Tile03 划向 Tile04 途中经过此缝隙时，
                              触发本层 MouseEnter → 令三个渐变环全部隐藏，
                              避免"Tile03 Leave → Tile02 短暂闪现 → Tile04 Enter"的回弹。
                            · Z 序：放在 Tile03/Tile04 之后，位于 ControlsDivider01 之前。
                            · 命中：Background=Transparent 才能吃到鼠标事件（null 不吃）。
                        -->
                        <Border x:Name="LaunchTile03Tile04Gap"
                                Canvas.Left="562.66"
                                Canvas.Top="382.67"
                                Width="184"
                                Height="21.33"
                                Background="Transparent"
                                IsHitTestVisible="True"
                                MouseEnter="LaunchTile03Tile04Gap_MouseEnter"
                                MouseLeave="LaunchTile03Tile04Gap_MouseLeave"
                                SnapsToDevicePixels="True"/>

                        <!--
                            控制区分割线：位于磁贴 3/4 右侧 32px,宽 2px,高度与磁贴 2 一致。
                            150% DPI 换算：宽 1.33 DIP，高 390.67 DIP；Canvas.Left = 562.66 + 184 + (32 / 1.5) = 767.99 DIP。
                            颜色走主题键 LaunchSectionDividerBrush（浅 #14000000 / 深 #3F3F3F），
                            与「资源」区 ControlsDivider02 共用；详见资源区该键的注释块。
                            ★ 改造前为 Background="#0080ff" + Opacity="0.3"，Opacity 已随之删除
                              （8% alpha 再乘 0.3 只剩 2.4%，两种主题下分割线都会消失）。
                        -->
                        <Border x:Name="ControlsDivider01"
                                Canvas.Left="767.99"
                                Canvas.Top="198"
                                Width="1.33"
                                Height="390.67"
                                Background="{DynamicResource LaunchSectionDividerBrush}"
                                SnapsToDevicePixels="True"/>

                        <!--
                            启动页磁贴 5：PS 设计稿 496px × 174px，位于分割线右侧约 32px，右边缘优先对齐磁贴 1。
                            150% DPI 换算：330.67 × 116 DIP；Canvas.Left = 1120 - 330.67 = 789.33 DIP。
                        -->
                        <Border x:Name="LaunchTile05"
                                Canvas.Left="789.33"
                                Canvas.Top="198"
                                Width="330.67"
                                Height="116"
                                Background="{DynamicResource LaunchTemplateTileBackgroundBrush}"
                                CornerRadius="8"
                                Cursor="Arrow"
                                MouseEnter="NodeModulesRing_MouseEnter"
                                MouseLeave="NodeModulesRing_MouseLeave"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 圆环：距上下左14DIP(=21px)，88×88DIP(=132px) -->
                                <Grid x:Name="NodeModulesRingGrid"
                                      Grid.Column="0"
                                      Width="88"
                                      Height="88"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="22,0,0,0"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      MouseLeftButtonUp="NodeModulesRing_MouseLeftButtonUp">
                                    <Ellipse x:Name="NodeModulesHealthBackgroundRing"
                                             Stroke="#22000000"
                                             StrokeThickness="8"/>
                                    <Ellipse x:Name="NodeModulesHealthProgressRing"
                                             Stroke="#DC2626"
                                             StrokeThickness="8"
                                             StrokeDashArray="0 276.46"
                                             StrokeDashCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Image x:Name="NodeModulesHealthStatusIcon"
                                           Source="{StaticResource NodeModulesErrorIconImage}"
                                           Width="10"
                                           Height="48"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                    <!-- 修复图标：悬浮时显示，63 PS px → 42 DIP，橙色 -->
                                    <Image x:Name="NodeModulesRepairIcon"
                                           Source="{StaticResource NodeModulesRepairIconImage}"
                                           Width="42"
                                           Height="42"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"/>
                                </Grid>

                                <!-- "🧩 运行依赖"：距顶45px→30DIP，距右66px→44DIP，字号42px→28DIP -->
                                <!-- "node_modules"：字号24px→16DIP，颜色#797979，居中，距上方18px→12DIP -->
                                <StackPanel Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Width="220"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,26,2,0">
                                    <TextBlock Text="🧩 运行依赖"
                                               HorizontalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource LaunchTemplateTileTextBrush}"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="node_modules"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"
                                               FontSize="16"
                                               Foreground="{DynamicResource LaunchTemplateTileSubTextBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="2"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>

                                <Border x:Name="NodeModulesRepairConfirmOverlay"
                                        Grid.ColumnSpan="2"
                                        Background="#D9000000"
                                        CornerRadius="8"
