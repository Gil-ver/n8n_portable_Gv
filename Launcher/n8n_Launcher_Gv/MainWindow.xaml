        <!-- 文件夹授权路径框：固定 28 DIP 高度内居中显示文字，避免默认 TextBox 模板裁切
             路径为只读，超出宽度时以省略号(...)结尾显示；PART_ContentHost 仍保留但隐藏，
             让 TextBox 依赖属性（Focusable/Cursor/Select）在代码里继续可用。 -->
        <Style x:Key="FolderPathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FolderPathTextBoxBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FolderPathTextBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- 路径文字留白：非负边距避免文字越框，同时尽量压缩左右留白。 -->
            <Setter Property="Padding" Value="3,0,3,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource FolderPathTextBoxForegroundBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Focusable="False"
                                              Visibility="Hidden"/>
                                <TextBlock Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文件夹授权浏览按钮：默认即显示浅黄色底色与黄色描边，不再使用悬浮态变化
             填充色走主题键 FolderBrowseButtonBackgroundBrush（浅 #FFFFF3D6 / 深 #FF80796B）；
             描边与按下态仍为硬编码浅色，详见该键声明处的注释。 -->
        <Style x:Key="FolderBrowseIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FolderBrowseButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#FFF9BC0F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFE8A8"/>
