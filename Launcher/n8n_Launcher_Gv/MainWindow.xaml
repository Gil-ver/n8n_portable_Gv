                                     · FontSize=16 DIP（= 24 PS px）
                                     · 现文案 "- All good things to those who wait. -"（37 字符）约 290 DIP，
                                       远小于 Width 1072，不会换行，TextAlignment=Center 保证始终居中。
                                       换文案只需改 Text 一处，无需动 Canvas.Left / Width / Canvas.Top。
                                       若日后文案含单引号（如旧稿 we'd），在双引号包裹的 XAML 属性值里无需转义。
                                     · Foreground={DynamicResource AboutSlogenBrush}（浅 #1F1F1F 原值 / 深 #CCCCCC）
                                 -->
                                 <TextBlock x:Name="AboutSlogenText"
                                            Canvas.Left="48"
                                            Canvas.Top="837"
                                            Width="1072"
                                            Text="- All good things to those who wait. -"
                                            FontSize="16"
                                            FontWeight="Normal"
                                            Foreground="{DynamicResource AboutSlogenBrush}"
                                           TextAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 底部版本号（PS: 45 物理像素 → 150% DPI 下 30 DIP） -->
                <Border x:Name="FooterBorder"
                        Grid.Row="1"
                        Height="30"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="1"
                        Background="#D4E7FA">
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,10,0"
                               FontSize="13.33"
                               Foreground="White"/>
                </Border>
            </Grid>
        </Grid>

        <!--
            ====== 标题栏：独立浮于最上层（不参与应用缩放，仅提供最小化/关闭按钮） ======
            位于 RootLayout 直接子级，处于 AppDesignSurface 视觉之上；
            高度由 wpfui 默认样式决定（不随 LayoutScale 缩放），
            以保证在任何 userScale 下最小化/关闭按钮的可点击面积恒定。
            x:Name="TitleBar" 保持不变，兼容后端 FindName 引用。
        -->
        <ui:TitleBar
            x:Name="TitleBar"
            Height="36"
            VerticalAlignment="Top"
            ShowMaximize="False"
            ShowMinimize="True"
            ShowClose="True"
            ButtonsForeground="{DynamicResource TitleBarButtonsForegroundBrush}"/>

    </Grid>
</ui:FluentWindow>



