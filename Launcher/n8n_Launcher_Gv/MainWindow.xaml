                                    <Border x:Name="SettingsThemeRow"
                                            Height="72"
                                            Margin="0,4,0,0"
                                            Background="{DynamicResource SettingsCardBrush}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <Grid Margin="24,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="250"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="模式选择 (Theme Selection)"
                                                           FontSize="16"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource SettingsHeadingBrush}"/>
