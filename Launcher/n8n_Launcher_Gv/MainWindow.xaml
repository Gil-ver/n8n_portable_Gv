            ★ PathToggle03/04/05 在 .cs 中仅有索引映射（GetFileAccessPermissionToggle），
              无任何 Foreground/Opacity 本地属性赋值 => 纯 DynamicResource 即可，无需额外重刷。
        -->
        <SolidColorBrush x:Key="EmojiCheckBoxGlyphBrush" Color="Black"/>
        <SolidColorBrush x:Key="EmojiCheckBoxDisabledGlyphBrush" Color="Black"/>
        <sys:Double x:Key="EmojiCheckBoxDisabledGlyphOpacity">0.35</sys:Double>

