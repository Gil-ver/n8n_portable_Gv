                                    <Border x:Name="SettingsLowPerformanceModeRow"
                                            Height="72"
                                            Margin="0,4,0,0"
                                            Background="{DynamicResource SettingsCardBrush}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <Grid Margin="24,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="250"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="精简效果 (Reduced Effects)"
                                                           FontSize="16"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource SettingsHeadingBrush}"/>
                                                <TextBlock Text="禁用特效以降低资源消耗，将重启启动器。(Disable effects to reduce resource usage. Launcher will restart.)"
                                                           Margin="0,6,0,0"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SettingsSubTextBrush}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="SettingsLowPerformanceModeComboBox"
                                                      Grid.Column="1"
                                                      Width="207"
                                                      Height="36"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Padding="10,4,10,4"
                                                      FontSize="13"
                                                      FocusVisualStyle="{x:Null}"
