        <SolidColorBrush x:Key="FolderPathTextBoxBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="FolderPathTextBoxBorderBrush" Color="#33000000"/>

        <!--
            路径文字 Foreground 深色模式两键（同为 PathInput03/04/05 三个只读路径框服务，
            按「未锁定 / 锁定」两态分别取色；锁定态 = 对应 PathToggle 勾选且路径非空）。
            · FolderPathTextBoxForegroundBrush        未锁定  浅 Black      / 深 White
            · FolderPathTextBoxLockedForegroundBrush  锁定    浅 #80000000  / 深 #5C5C5C
            ★ 浅色两项 = 改造前原字面值（本地 Foreground="Black" 与 .cs 里的
              FileAccessPathInputLockedBrush = #80000000），逐位复原、零回归。
            ★ 锁定态浅色在 .cs 中必须用 Color.FromArgb(0x80, 0, 0, 0) 保留 alpha：
              #80000000 是 50% 透明黑（透出白底后呈中灰），若误写成 FromRgb(0x80,0x80,0x80)
              会变成实心灰 => 浅色可见回归。
            ★ 模板内显示文字的 TextBlock 用 Foreground="{TemplateBinding Foreground}"
              转发 TextBox.Foreground，故只需换 Foreground 来源，模板无需改动。
            ★ .cs 的 UpdateFileAccessPathInputVisualState() 会按锁定态改写 Foreground，
              且那是「本地属性」赋值（优先级高于 DynamicResource / Style Setter）：
              必须用 SetResourceReference 挂键而非 new SolidColorBrush，
              这样 Resources[键] 更新时表达式自动重算，主题切换无需额外回刷视觉态。
            ★ 三个用点仍保留本地 Foreground="{DynamicResource ...}"：
              保证窗口首帧（视觉态方法尚未执行前）深色也正确。
        -->
        <SolidColorBrush x:Key="FolderPathTextBoxForegroundBrush" Color="Black"/>
        <SolidColorBrush x:Key="FolderPathTextBoxLockedForegroundBrush" Color="#80000000"/>

        <!--
            FolderBrowseIconButtonStyle 浏览按钮「圆角矩形填充」单键
            （LaunchTile09「文件夹访问授权」的 BrowsePathButton03/04/05 三个图标按钮共用同一 Style）。
            · FolderBrowseButtonBackgroundBrush  浅 #FFFFF3D6 / 深 #FF80796B（用户指定）
            ★ 浅色 = 改造前 Style Setter 原字面值 #FFFFF3D6，逐位复原、零回归。
            ★ 两个分支都是不透明 6 位 RGB，.cs 中一律用 Color.FromRgb 即可，无 alpha 陷阱。
            ★ 本轮按用户要求「只改填充」，以下三项一律保持硬编码浅色、不做主题化：
              · 描边 BorderBrush = #FFF9BC0F（品牌黄，深色底上对比度足够）
              · 按下态 Chrome.Background = #FFFFE8A8（模板 IsPressed 触发器内）
              · 图标 FileYellowIconImage 两条 GeometryDrawing Brush = #F9BC0F
              已知观感副作用：深色下按下瞬间由 #80796B 跳到浅黄 #FFE8A8，对比较强；
              日后若需缓和，只需再补一个「按下态」键，不影响本键。
            ★ 禁止对 #FFF3D6 做全局替换：该字面值另有 3 处属于别的控件——
              ConsoleActionTileBorderStyle 悬浮色、NodeModulesOverlayButtonStyle 悬浮/按下色，
              它们与本按钮无关，一起改会造成跨控件误伤。
            ★ 三个用点均未写本地 Background，.cs 中 BrowsePathButton03/04/05
              也无任何画刷赋值 => 纯 DynamicResource 即可，无需额外重刷。
        -->
        <SolidColorBrush x:Key="FolderBrowseButtonBackgroundBrush" Color="#FFFFF3D6"/>

        <!--
            启动页「运行 n8n」主按钮 LaunchTile02、「停止运行 (Stop)」LaunchTile03
            与「重新启动 (Restart)」LaunchTile04 三块动作磁贴的主题双键。
            · LaunchActionTileBackgroundBrush  浅 White     / 深 #FF2B2B2B（用户指定）
            · LaunchActionTileTextBrush        浅 Black     / 深 White（用户指定）
            ★ 浅色两项 = 改造前 Border.Background="White" / TextBlock.Foreground="Black"
              的原字面值，逐位复原、零回归。
            ★ 三块磁贴属同一功能组（运行控制的三个动作按钮：启动 / 停止 / 重启），
              视觉必须永远一致，故共用同一对键；不与任何其它控件复用，避免跨控件误伤。
              （Tile03/04 先接入，Tile02 于后续一轮补齐，键值与深浅取值完全未变。）
            ★ Tile03/04 底色能被看见的前提：Stop.png / restart.png 为半透明 PNG（已确认），
              满幅 Stretch=Fill 铺在 Border 之上但四周透明，故 Border 底色会透出来。
              若日后换成不透明素材，则需改为按主题切换两套 PNG，而非改这里的键。
            ★ Tile02 的底色在「未运行」态整片可见（画板上只有透明装饰层）；
              进入运行态后云层（顶层 #F0F7FC 近白）会覆盖画板下 2/3，
              此时深色白字压近白云存在可读性问题 —— 属云层/动画侧待办，
              不在本键职责范围内，勿通过改这两个键"顺手修复"。
            ★ 两个分支都是不透明 6 位 RGB，.cs 中一律用 Color.FromRgb，无 alpha 陷阱。
            ★ 本轮不动的相邻元素：灰度禁用图 StopLaunchTileGrayscaleImage /
              RestartLaunchTileGrayscaleImage、渐变环 LaunchTile02/03/04GradientRing
              及其旋转绑定、Tile02 三层云的圆角 Clip 与火箭组件、以及磁贴悬浮/按下态逻辑。
            ★ .cs 中 LaunchTile02/03/04 只被赋值 IsEnabled / IsHitTestVisible / Cursor /
              ToolTip（Tile02ActionText 仅被赋 .Text / .Opacity），
              无任何画刷本地赋值 => 纯 DynamicResource 即可，无需额外重刷。
        -->
        <SolidColorBrush x:Key="LaunchActionTileBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="LaunchActionTileTextBrush" Color="Black"/>

        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
