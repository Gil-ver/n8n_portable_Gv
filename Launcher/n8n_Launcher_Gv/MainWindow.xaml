    <!--
        ===================================================================
        窗口根层：ClipToBounds=True 允许 AppDesignSurface 视觉超出窗口时不泄露。
        ===================================================================
        DPI/DIP 基础规则：
        - XAML / WPF 逻辑尺寸单位 = DIP（Device Independent Pixel）
        - 一倍设计基准固定为 2160×1440 物理像素。
        - 设计画布固定为 1440×960 DIP（2160×1440 在 150% 设计 DPI 下的 WPF 坐标）。
        - userScale 是唯一业务缩放；系统 DPI 只参与统一补偿，不改变文字/图标/间距比例。
        - 最终物理尺寸 = 设计物理尺寸 × userScale。
        - 左侧栏 272 DIP（设计基准 150% → 408 物理像素），50% 档应为 204 物理像素。
        ===================================================================
    -->
    <Grid x:Name="RootLayout" ClipToBounds="True">

        <!--
            =============================================================
            AppDesignSurface — 应用唯一设计画布（固定 1440×960 DIP，统一缩放）
            尺寸在 SetWindowScaleCore 中固定: Width = DESIGN_DIP_WIDTH (1440)
            LayoutTransform = userScale × 1.5 / systemDpi，CenterX/CenterY = 0 保证左对齐缩放
            =============================================================
        -->
        <Grid x:Name="AppDesignSurface"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              ClipToBounds="True">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="LayoutScale"
                                ScaleX="1.0"
                                ScaleY="1.0"
                                CenterX="0"
                                CenterY="0"/>
            </Grid.LayoutTransform>

            <!-- ====== 右侧全高不透明浅蓝灰底板 ====== -->
            <Border x:Name="RightPanelBg"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="272,0,0,0"
                    Background="#EEF4F9">
            </Border>

            <!-- ====== 左侧毛玻璃 272 DIP (150% DPI → 408 物理像素)，全高 ====== -->
            <Border x:Name="SidebarBorder"
                    Width="272"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 左上角程序标识：独立于下方品牌大图，不参与品牌链接区域 -->
                    <StackPanel x:Name="HeaderPanel" Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image x:Name="SidebarIcon" Width="17.33" Height="17.33"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="SidebarTitleText"
                                   Text="n8n_launcher_Gv"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0"
                                   FontSize="14.67"/>
                    </StackPanel>

                    <!--
                        左侧品牌大图：PS 设计稿 360px × 150px，150% DPI 下换算为 240 × 100 DIP。
                        Acrylic 色块宽 408px → 272 DIP；左右各 24px → 16 DIP；距离顶部 72px → 48 DIP。
                        外层 Border 预留后续点击链接入口，链接目标确定后再绑定事件。
                    -->
                    <!--
                        品牌 Logo 承载层：常态透明，点击跳转便携包 GitHub 仓库。
                        复用关于页 5 按钮通用 handler AboutSiteButton_MouseLeftButtonUp（读取 sender.Tag）。
                    -->
                    <Border x:Name="SidebarBrandLinkHost"
                            Grid.RowSpan="2"
                            Width="240"
                            Height="100"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,48,0,0"
                            Background="Transparent"
                            Cursor="Hand"
                            Tag="https://github.com/Gil-ver/n8n_portable_Gv"
                            MouseLeftButtonUp="AboutSiteButton_MouseLeftButtonUp">
                        <Image x:Name="SidebarBrandLogo"
                               Width="240"
                               Height="100"
                               Stretch="Uniform"
                               Source="icon/logo_light.png"
                               IsHitTestVisible="False"/>
                    </Border>

