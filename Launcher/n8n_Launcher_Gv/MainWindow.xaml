                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EmojiGlyph" Property="Text" Value="☑️"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="EmojiGlyph" Property="Opacity" Value="{DynamicResource EmojiCheckBoxDisabledGlyphOpacity}"/>
                                <Setter TargetName="EmojiGlyph" Property="Foreground" Value="{DynamicResource EmojiCheckBoxDisabledGlyphBrush}"/>
