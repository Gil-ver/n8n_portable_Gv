                                                           Margin="0,6,0,0"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SettingsSubTextBrush}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="SettingsThemeComboBox"
                                                      Grid.Column="1"
                                                      Width="207"
                                                      Height="36"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Padding="10,4,10,4"
                                                      FontSize="13"
                                                      FocusVisualStyle="{x:Null}"
                                                      SelectionChanged="SettingsThemeComboBox_SelectionChanged">
