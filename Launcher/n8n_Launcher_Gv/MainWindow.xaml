        <!-- 文件夹授权路径框内清空按钮：显示在路径框右侧，点击清空当前授权路径
             内部 × 图形完全由几何两条 Line 绘制，不再依赖字体。
             - 外圆：Chrome Border，16×16 DIP（=24×24 PS px），CornerRadius=8
             - × 图形：两条对角 Line，端点 Round（=胶囊头旋转 45°）
               线宽 1.33 DIP（=2 PS px），颜色 #505050
               尺寸 6.67×6.67 DIP（=10×10 PS px，含圆头外缘）：
                 Line 端点 (5.33,5.33)-(10.67,10.67) / (10.67,5.33)-(5.33,10.67)；
                 圆头半径 0.67 DIP，端点在 X/Y 轴向各外扩 0.67 DIP →
                 X/Y 轴向包围盒 4.67~11.33 DIP = 6.67 DIP = 10 PS px。
               中心 (8,8) 与外圆几何中心严格重合，永远不受字体/系统变化影响。 -->
        <Style x:Key="FolderPathClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <!-- 常态外圆始终可见（灰 #D2D2D2）；悬浮浅一档 #E2E2E2；按下深一档 #B8B8B8。 -->
            <Setter Property="Background" Value="#D2D2D2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid Width="16" Height="16">
                                <Line X1="5.33" Y1="5.33" X2="10.67" Y2="10.67"
                                      Stroke="#505050"
                                      StrokeThickness="1.33"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      IsHitTestVisible="False"/>
                                <Line X1="10.67" Y1="5.33" X2="5.33" Y2="10.67"
                                      Stroke="#505050"
                                      StrokeThickness="1.33"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E2E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B8B8B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 控制台底部操作按钮：白底圆角，悬浮时仅显示浅黄色背景，无描边 -->
        <Style x:Key="ConsoleActionTileBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFF3D6"/>
                </Trigger>
            </Style.Triggers>
