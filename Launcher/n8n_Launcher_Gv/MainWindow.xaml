<!--
    ★ 窗口图标（下方 Icon 属性）必须喂 .ico 而非 .png：
      ICO 是多帧容器（本项目含 16/24/32/48/64/128/256 七帧，各帧由 512 原图独立 LANCZOS 精修），
      Windows 会按任务栏 / Alt+Tab / 标题栏实际需要的像素尺寸直接挑最接近的那一帧。
      若指向 512×512 的 PNG，WPF 只能在渲染期把 512 双线性直缩到 16~32px（缩小 16~32 倍），
      必然糊边 —— 这正是改造前"图标发糊"的根因之一（另一处在 .cs 的 LoadSidebarIcon）。
    ★ 注释只能放在根元素之外，不可插入属性列表中间（XML 语法限制，曾踩坑）。
    ★ 图标源文件在 Launcher\icon\，项目内 icon\ 是副本，改图后必须重跑 make_ico.py 同步。
-->
<ui:FluentWindow x:Class="n8n_launcher_Gv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:n8n_launcher_Gv"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="n8n_launcher_Gv"
        Icon="icon/n8n_launcher.ico"
        Width="1440"
        Height="960"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        FontFamily="{StaticResource LauncherFontFamily}">

    <ui:FluentWindow.Resources>
        <!-- 字符串非空 → true：用于路径为空时禁用勾选框 -->
        <local:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter"/>

        <!-- file_yellow.svg -> WPF DrawingImage；用于文件夹访问授权“浏览”按钮图标 -->
        <DrawingImage x:Key="FileYellowIconImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F9BC0F" Geometry="M317.27 49.7l0 10.46 -271.08 211.79 -21.7 0c-5.89,0 -11.23,-2.39 -15.1,-6.25 -3.86,-3.87 -6.25,-9.2 -6.25,-15.1l0 -228.02c0,-10.74 8.71,-19.45 19.45,-19.45l92 0c4.3,0 8.47,1.43 11.88,4.05l24.64 19.03c3.4,2.62 7.58,4.05 11.88,4.05l134.84 0c10.73,0 19.44,8.71 19.44,19.45z"/>
                    <GeometryDrawing Brush="#FEFEFE" Geometry="M43.52 260.29l-2.41 0c-5.7,0 -10.33,-4.62 -10.33,-10.32l0 -192.54c0,-6.32 5.12,-11.44 11.44,-11.44l243.27 0c6.33,0 11.44,5.12 11.44,11.44l0 2.74 -253.41 200.12z"/>
                    <GeometryDrawing Brush="#F9BC0F" Geometry="M337.17 60.16c12.36,0 21.62,11.31 19.19,23.42l-34.41 171.21c-2,9.98 -10.77,17.15 -20.94,17.15l-276.53 0c10.17,0 18.93,-7.18 20.94,-17.15l32.24 -160.43c1.84,-9.14 9.87,-15.71 19.18,-15.71l89.19 0c3.76,0 7.44,-1.09 10.6,-3.13l18.98 -12.25c3.17,-2.04 6.84,-3.12 10.61,-3.12l110.94 0z"/>
                    <GeometryDrawing Brush="#E6AE11" Geometry="M356.36 83.59l-34.41 171.21c-2,9.98 -10.77,17.15 -20.94,17.15l-251.74 0c9.85,-0.89 111.59,-14.1 178.36,-41.16 45.63,-18.49 54.4,-29.22 89.64,-170.62l19.91 0c12.36,0 21.62,11.31 19.19,23.42z"/>
                    <GeometryDrawing Brush="#C19314" Geometry="M353.28 82.97l-34.4 171.21c-1.71,8.48 -9.22,14.64 -17.87,14.64l-260.2 0c3.84,-3.43 6.61,-8.07 7.68,-13.4l32.24 -160.44c1.53,-7.65 8.31,-13.2 16.12,-13.2l89.19 0c4.37,0 8.63,-1.26 12.3,-3.63l18.98 -12.25c2.66,-1.71 5.74,-2.62 8.91,-2.62l110.94 0c4.95,0 9.58,2.19 12.72,6.02 3.13,3.83 4.38,8.81 3.39,13.65zm-328.8 185.85c-4.87,0 -9.44,-1.89 -12.88,-5.34 -3.44,-3.44 -5.34,-8.02 -5.34,-12.89l0 -228.02c0,-8.99 7.32,-16.31 16.31,-16.31l92 0c3.58,0 7.12,1.21 9.97,3.4l24.64 19.02c3.93,3.03 8.83,4.7 13.8,4.7l134.84 0c8.99,0 16.31,7.32 16.31,16.31l0 7.33 -87.9 0c-4.38,0 -8.63,1.25 -12.31,3.63l-18.98 12.25c-2.67,1.72 -5.74,2.62 -8.91,2.62l-89.19 0c-10.77,0 -20.13,7.66 -22.26,18.23l-32.24 160.43c-1.7,8.47 -9.22,14.63 -17.87,14.63zm330.25 -203.47c-4.33,-5.28 -10.73,-8.31 -17.56,-8.31l-16.77 0 0 -7.33c0,-12.45 -10.12,-22.58 -22.57,-22.58l-134.84 0c-3.59,0 -7.13,-1.2 -9.97,-3.39l-24.64 -19.03c-3.93,-3.04 -8.83,-4.71 -13.79,-4.71l-92 0c-12.45,0 -22.58,10.13 -22.58,22.58l0 228.02c0,6.54 2.55,12.69 7.18,17.31 4.62,4.62 10.77,7.17 17.31,7.17l276.53 0c11.62,0 21.72,-8.27 24.01,-19.67l34.41 -171.21c1.35,-6.69 -0.37,-13.57 -4.69,-18.86z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- node_modules 状态图标：error.svg / right.svg；颜色按设计稿保持红/蓝 -->
        <DrawingImage x:Key="NodeModulesErrorIconImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#E62129" Geometry="M3.07 35.28c0,3.54 1.38,6.41 3.07,6.41 1.7,0 3.07,-2.87 3.07,-6.41l3.07 -28.86c0,-3.54 -2.75,-6.41 -6.15,-6.41 -3.4,0 -6.15,2.87 -6.15,6.41l3.07 28.86z M6.15 47.65c-3.4,0 -6.15,2.75 -6.15,6.15 0,3.4 2.75,6.15 6.15,6.15 3.4,0 6.15,-2.75 6.15,-6.15 0,-3.4 -2.75,-6.15 -6.15,-6.15z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="NodeModulesRightIconImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#256BEB" Geometry="M75.14 150.34c-5.2,0 -10.39,-1.91 -14.49,-6.02l-54.69 -54.69c-7.93,-7.93 -7.93,-21.06 0,-28.99 7.93,-7.93 21.06,-7.93 28.99,0l40.2 40.2 94.89 -94.89c7.93,-7.93 21.06,-7.93 28.99,0 7.93,7.93 7.93,21.06 0,28.99l-109.39 109.39c-4.1,4.1 -9.3,6.02 -14.49,6.02z"/>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!--
            左侧导航按钮状态叠加层画刷。
            此处为浅色模式默认值（与原硬编码一致）；深色模式下由
            MainWindow.xaml.cs 的 UpdateThemeColors() 替换为等透明度的白色叠加，
            因为黑色叠加在深色 Acrylic 背景上几乎不可见。
        -->
        <SolidColorBrush x:Key="NavHoverBrush" Color="#2B000000"/>
        <SolidColorBrush x:Key="NavPressedBrush" Color="#33000000"/>

        <!--
            设置页标题文字色（页标题 / 分类名 / 卡片主标题，共 14 处）。
            此处为浅色模式默认值，与原硬编码 #1F1F1F 逐位相同；
            深色模式下由 MainWindow.xaml.cs 的 UpdateThemeColors() 替换为白色。
            注意：卡片副标题(#80000000)、d/h/m 单位标签、重置按钮文字不在此画刷范围内。
        -->
        <SolidColorBrush x:Key="SettingsHeadingBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SettingsCardBrush" Color="White"/>
        <SolidColorBrush x:Key="SettingsSubTextBrush" Color="#80000000"/>
        <!--
            设置页标题「设置 (Settings)」下方的横分割线（SettingPageCanvas 内，Canvas.Top=38）。
            · 浅 #14000000（8% 透明黑，叠在设置页白底上≈#EBEBEB） / 深 #3F3F3F（不透明灰）
              —— 与 ExecutionHeaderDividerBrush、InsightsCardDividerBrush、LaunchSectionDividerBrush
              采用同一套分割线方案，全项目 4 个分割线键取值彻底统一。
            ★ 本轮为「取值统一」有意破例：改造前浅 #E6E6E6（不透明灰）/ 深 #2B2B2B。
              深色旧值 #2B2B2B 压在 #1F2021 页底板上明度差仅约 12，几乎不可见；
              浅色由不透明灰改为半透明黑后叠白底≈#EBEBEB，与旧值肉眼不可分辨，
              故不再满足「浅色渲染逐位不变」，属可接受的取值统一代价。
            ★ 浅色为半透明色，C# 侧必须用 Color.FromArgb(0x14, 0, 0, 0) 还原，
              若误用 FromRgb 会丢 alpha 变成纯黑重线（本项目历史踩坑点，已第 4 次遇到）。
            ★ 键名独立于其余 3 个分割线键（四者取值恰好相同，属人工对齐，
              日后单调设置页这一处不会连带影响执行记录页 / 洞察卡片 / 启动页）。
        -->
        <SolidColorBrush x:Key="SettingsDividerBrush" Color="#14000000"/>
        <!--
            执行记录页右上角刷新磁贴（ExecutionRecordsRefreshTile）的内层可见底板。
            此处为浅色模式默认值，与原硬编码 White 逐位相同；
            深色模式下由 MainWindow.xaml.cs 的 UpdateThemeColors() 替换为 #2B2B2B。
            ★ 键名独立于 ConsoleTileBrush（两者深色值恰好同为 #2B2B2B，属人工对齐，
              日后单独调控制台 5 个操作磁贴的深色底不会连带影响本按钮）。
            ★ 按钮内 🔄 emoji 的 Foreground="#0080FF" 不在此画刷范围内，保持原硬编码。
        -->
        <SolidColorBrush x:Key="ExecutionRefreshTileBrush" Color="White"/>
        <!-- 执行记录页表格：以下 5 个键的浅色值与改造前硬编码逐位相同，浅色渲染零回归。
             深色值由 UpdateThemeColors() 覆写：底板 #2B2B2B / 斑马 #1F2021 / 表头与单元格文字 White /
             表头下分割线 #3F3F3F。
             偶数行本身是 Transparent，透出的就是 ExecutionTablePanelBrush，故"整体底色"只需改底板一处。
             ★ ExecutionHeaderDividerBrush 浅色 #14000000 是 8% 透明黑（叠白底≈#EBEBEB），
               深色改为不透明 #3F3F3F —— 8% 黑叠在 #2B2B2B 底板上几乎不可见。
               对应 C# 分支的浅色必须用 Color.FromArgb 保留 alpha，用 FromRgb 会退化成纯黑实线。 -->
        <SolidColorBrush x:Key="ExecutionTablePanelBrush" Color="White"/>
        <SolidColorBrush x:Key="ExecutionRowAltBrush" Color="#EEF4F9"/>
        <SolidColorBrush x:Key="ExecutionHeaderTextBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="ExecutionCellTextBrush" Color="Black"/>
        <SolidColorBrush x:Key="ExecutionHeaderDividerBrush" Color="#14000000"/>
        <!-- 执行记录页 Workflow / Status 表头筛选下拉框（两个 Popup 共用同一套键）。
             以下 6 个键的浅色值与改造前硬编码逐位相同，浅色渲染零回归；
             深色值由 UpdateThemeColors() 覆写：
               外框底 #2B2B2B / 外框描边 #3F3F3F / 偶数行 #2B2B2B / 奇数行 #242424 /
               条目文字 White / 悬停底色 #1F2021。
             ★ 深色下偶数行与外框底同值（#2B2B2B），视觉上表现为"隔行透空"，
               与浅色下 White + #F5F5F5 的弱分隔观感等价。
             ★ ExecutionFilterPopupBorderBrush 浅色 #22000000 是 13% 透明黑，
               对应 C# 分支必须用 Color.FromArgb 保留 alpha，用 FromRgb 会退化成纯黑实线（浅色回归）。
             ★ 条目行是 C# 动态创建（CreateExecutionFilterOptionRow），
               必须走 SetResourceReference 才能在切主题时自动重刷，不能直接塞画刷实例。 -->
        <SolidColorBrush x:Key="ExecutionFilterPopupBrush" Color="White"/>
        <SolidColorBrush x:Key="ExecutionFilterPopupBorderBrush" Color="#22000000"/>
        <SolidColorBrush x:Key="ExecutionFilterRowEvenBrush" Color="White"/>
        <SolidColorBrush x:Key="ExecutionFilterRowOddBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ExecutionFilterTextBrush" Color="Black"/>
        <SolidColorBrush x:Key="ExecutionFilterRowHoverBrush" Color="#E6EEF8"/>
        <!--
            控制台页左上角状态标题文字色（ConsoleStatusText，如「未运行 (Not Running)」）。
            此处为浅色模式默认值，与原硬编码 #1F1F1F 逐位相同；
            深色模式下由 MainWindow.xaml.cs 的 UpdateThemeColors() 替换为白色。
            独立键名（不复用 SettingsHeadingBrush）以便后续对运行状态做差异化配色。
        -->
        <SolidColorBrush x:Key="ConsoleHeadingBrush" Color="#1F1F1F"/>
        <!--
            TitleBar 最小化/关闭按钮前景色。
            浅色 #1F1F1F（与导航按钮文字同源）；深色 White。
            窗口失焦时由 .cs 的 Window_Deactivated 直接覆盖 TitleBar.ButtonsForeground 本地属性，
            激活时 ClearValue 回退到本 DynamicResource。
        -->
        <SolidColorBrush x:Key="TitleBarButtonsForegroundBrush" Color="#1F1F1F"/>
        <!--
            控制台运行情况大块（ConsoleOutputPanel）底板色。
            浅色模式默认值与原硬编码 White 逐位相同；深色模式由 UpdateThemeColors() 替换为 #2B2B2B。
        -->
        <SolidColorBrush x:Key="ConsoleOutputPanelBrush" Color="White"/>
        <!--
            控制台运行情况文字（ConsoleOutputTextBox）前景色。
            浅色模式默认值与原硬编码 #1F1F1F 逐位相同；深色模式替换为 #959595
            （纯白在深底上过亮刺眼，降到中灰仍可清晰阅读长篇日志）。
        -->
        <SolidColorBrush x:Key="ConsoleOutputTextBrush" Color="#1F1F1F"/>
        <!--
            控制台页底部 5 个操作按钮（ConsoleActionTile01~05）的底板色。
            此处为浅色模式默认值，与原硬编码 White 逐位相同；
            深色模式下由 UpdateThemeColors() 替换为 #2B2B2B（与 SettingsCardBrush 深色值同源）。
            Tile05 三层叠加图标的中层遮挡层也引用此画刷，保证与按钮底色永远一致。
        -->
        <SolidColorBrush x:Key="ConsoleTileBrush" Color="White"/>
        <!--
            上述 5 个按钮内的文字 / emoji 图标 / Tile05 顶层矢量三角的前景色。
            此处为浅色模式默认值，与原硬编码 #1F1F1F 逐位相同；深色模式替换为白色。
            注：WPF 不渲染 COLR 彩色字形，📋📤🔁⏹️ 按单色字形绘制，故走 Foreground 即可整体变色。
        -->
        <SolidColorBrush x:Key="ConsoleTileTextBrush" Color="#1F1F1F"/>
        <!--
            上述 5 个按钮的悬浮内描边色（各 Border.Style → DataTrigger 内的 BorderBrush）。
            此处为浅色模式默认值，与原硬编码 #CCD0D3 逐位相同；
            深色模式下由 UpdateThemeColors() 替换为 #3F3F3F —— #CCD0D3 压在 #2B2B2B 底板上
            对比过强，会形成一圈刺眼亮环。
        -->
        <SolidColorBrush x:Key="ConsoleTileHoverBorderBrush" Color="#CCD0D3"/>
        <!--
            关于页 5 个链接按钮（AboutSite*Button）内超链接图标 HyperlinkIconImage 的填充色。
            该图标是 DrawingImage，颜色写在 GeometryDrawing.Brush 上，无法通过 Foreground 继承，
            故单独抽一个画刷，由 UpdateThemeColors() 统一切换：
              浅色 #333333（与原硬编码逐位相同）／深色 #E6E6E6。
            深色底板为 #2B2B2B，若仍用 #333333 则明度差仅 8 级，图标几乎不可见。
        -->
        <SolidColorBrush x:Key="AboutLinkIconBrush" Color="#333333"/>
        <!--
            关于页主卡片中文副文案（AboutHeaderSubtitleText，两行中文说明）色。
            此处为浅色模式默认值，与改动前原硬编码 Black(#000000) 逐位相同；
            深色模式下由 UpdateThemeColors() 替换为纯白。
            注意：不复用 SettingsHeadingBrush（其浅色分支是 #1F1F1F），避免浅色渲染结果偏移。
            英文行(#ABABAB)与版本号(White)不在此画刷范围内，保持原硬编码。
        -->
        <SolidColorBrush x:Key="AboutHeaderSubtitleBrush" Color="Black"/>

        <!--
            关于页主卡片英文副文案（AboutHeaderSubtitleEnglishText，两行英文说明）色。
            此处为浅色模式默认值，与改动前原硬编码 #ABABAB 逐位相同（浅色永久锁死此值）；
            深色模式下由 UpdateThemeColors() 替换为 #52FFFFFF（与 SettingsSubTextBrush 深色同值，
            使深色下与设置页功能描述行、关于页 5 按钮副文字视觉统一）。
        -->
        <SolidColorBrush x:Key="AboutHeaderSubtitleEnglishBrush" Color="#ABABAB"/>

        <!--
            关于页教程区右下角浮动工具栏 2 个 24×24 按钮（中英切换 / 复制）的深色适配画刷。
            · 底板不新开键，直接复用 SettingsCardBrush（浅 White / 深 #2B2B2B），
              与关于页 5 个链接按钮底色永远一致 —— 用户明确要求"底色用那 5 个链接按钮的底色"。
            · 描边：下方 AboutTutorialToolButtonBorderBrush，
              浅色 #E8EBED（= 替换前 XAML 原硬编码，逐位复原）/
              深色 #3F3F3F（= ConsoleTileHoverBorderBrush 深色值同源，
              即关于页 5 链接按钮"悬浮描边"的深色值 —— 用户明确要求"描边用那 5 个按钮的悬浮描边"）。
              注意：这两个小按钮的描边是 BorderThickness=1.33 常显，不是 hover 才出现，
              显隐逻辑本轮完全不变，只换颜色。
            · 文字：下方 AboutTutorialToolButtonTextBrush，仅作用于"中/EN"这一个 TextBlock。
              浅色 Black —— 替换前该 TextBlock 根本没写 Foreground，走 WPF 隐式默认黑 #FF000000，
              显式写 Black 后渲染结果逐位相同，零回归。
              📋 复制按钮的 emoji 不接入任何画刷：WPF 对该字形按彩色 COLR 渲染，Foreground 不生效。
        -->
        <SolidColorBrush x:Key="AboutTutorialToolButtonBorderBrush" Color="#E8EBED"/>
        <SolidColorBrush x:Key="AboutTutorialToolButtonTextBrush" Color="Black"/>

        <!--
            关于页教程区正文文本框 AboutTutorialTextBox 的深色适配画刷（3 个键）。
            ★ 本轮只新增深色取值，浅色三项全部锁死为替换前 XAML 原硬编码值，浅色渲染逐位不变。
            · 底板 AboutTutorialTextBoxBackgroundBrush：浅 #F8FBFE（原值）/ 深 #1C1C1C（用户指定）。
            · 正文 AboutTutorialTextBoxForegroundBrush：浅 #1F1F1F（原值）/ 深 #CCCCCC（用户指定，
              与控制台日志正文 ConsoleOutputTextBrush 深色值同源，长文本在深底上不刺眼）。
            · 描边 AboutTutorialTextBoxBorderBrush：浅 #18000000（原值，9% 黑极淡线）/ 深 #3F3F3F。
              深色值刻意与 AboutTutorialToolButtonBorderBrush 深色同值 —— 用户要求"描边和上面两个按钮一样"。
              ★ 这里不直接复用那个键：它浅色是 #E8EBED，复用会把浅色淡线改成浅灰实色，属浅色回归，禁止。
              两键深色同值是人工对齐，不会自动跟随；日后若调按钮描边深色，需人工决定是否同步本键。
            TextBox.Template 内已是 {TemplateBinding Background/BorderBrush}，自动跟随，模板无需改动。
        -->
        <SolidColorBrush x:Key="AboutTutorialTextBoxBackgroundBrush" Color="#F8FBFE"/>
        <SolidColorBrush x:Key="AboutTutorialTextBoxForegroundBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="AboutTutorialTextBoxBorderBrush" Color="#18000000"/>

        <!--
            关于页教程区左侧 10 个 Border 按钮的底板画刷（2 个键，未激活 / 激活）。
