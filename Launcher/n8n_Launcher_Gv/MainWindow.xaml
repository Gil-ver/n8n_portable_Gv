                                           FontWeight="Bold"
                                           LineHeight="20"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource ConsoleHeadingBrush}"/>

                                <!--
                                    ⚙ 调试用：控制台右上角字体切换磁贴。
                                    视觉规格 100% 复刻执行记录页 ExecutionRecordsRefreshTile：
                                      · 位置：Canvas.Left=1094 / Canvas.Top=6；尺寸 26×26 DIP
                                      · 外层透明壳 + 内层白底 CornerRadius=4
                                    两态切换（点击循环）：
                                      · 默认态 Y = 系统雅黑优先 (Yahei，即当前默认字体链)
                                      · 点击态 S = 强制内嵌思源黑体 CN (SourceHanSans)
                                    发布前将 Visibility 改为 Collapsed（或整块删除）即可隐藏。
                                -->
                                <Border x:Name="ConsoleFontSwitchTile"
                                        Canvas.Left="1094"
                                        Canvas.Top="6"
                                        Width="26"
                                        Height="26"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ConsoleFontSwitchTile_MouseLeftButtonUp"
                                        ToolTip="切换字体（调试用，发布前隐藏）"
                                        Visibility="Collapsed"
                                        SnapsToDevicePixels="True">
                                    <Border Background="White"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="True">
                                        <TextBlock x:Name="ConsoleFontSwitchTileGlyph"
                                                   Text="Y"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0080FF"/>
                                    </Border>
                                </Border>

                                <!--
                                    控制台输出大块：PS 设计稿 1608px × 1080px，距整图顶边 120px，距整图右边 72px。
                                    150% DPI 换算：1072 × 720 DIP；内容区从整图顶边 72px、左侧 408px 开始，所以 Canvas.Left = 48 DIP，Canvas.Top = (120 - 72) / 1.5 = 32 DIP。
                                -->
                                <Border x:Name="ConsoleOutputPanel"
                                        Canvas.Left="48"
                                        Canvas.Top="38"
                                        Width="1072"
                                        Height="748"
                                        Background="{DynamicResource ConsoleOutputPanelBrush}"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <TextBox x:Name="ConsoleOutputTextBox"
                                             Margin="18"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             BorderThickness="0"
                                             BorderBrush="Transparent"
                                             Background="Transparent"
                                             FocusVisualStyle="{x:Null}"
                                             Foreground="{DynamicResource ConsoleOutputTextBrush}"
                                             FontFamily="Consolas"
                                             FontSize="17"
                                             ContextMenu="{StaticResource ReadOnlyTextBoxContextMenu}"
                                             Text="">
                                        <TextBox.Resources>
                                            <!-- 控制台内部 ScrollBar：常规样式（上下三角 + 标准宽度）
                                                 Thumb 默认 #8b8b8b，悬浮/拖拽 #636363；箭头三角同色。 -->
                                            <Style TargetType="{x:Type ScrollBar}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Width" Value="6"/>
                                                <Setter Property="MinWidth" Value="6"/>
                                                <Setter Property="Margin" Value="13,0,-13,0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="7"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="7"/>
                                                                </Grid.RowDefinitions>

                                                                <RepeatButton Grid.Row="0"
                                                                              Command="ScrollBar.LineUpCommand"
                                                                              Focusable="False">
                                                                    <RepeatButton.Template>
                                                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                            <Border Background="Transparent">
                                                                                <Path x:Name="ArrowUp"
                                                                                      Data="M 0 3 L 6 3 L 3 0 Z"
                                                                                      Fill="#8b8b8b"
                                                                                      Stretch="Fill"
                                                                                      Width="6"
                                                                                      Height="3"
                                                                                      Margin="0,-6,0,0"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Top"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ArrowUp" Property="Fill" Value="#636363"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </RepeatButton.Template>
                                                                </RepeatButton>

                                                                <Track x:Name="PART_Track"
                                                                       Grid.Row="1"
                                                                       IsDirectionReversed="True">
                                                                    <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                                      Focusable="False">
                                                                            <RepeatButton.Template>
                                                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                                    <Border Background="Transparent"/>
                                                                                </ControlTemplate>
                                                                            </RepeatButton.Template>
                                                                        </RepeatButton>
                                                                    </Track.DecreaseRepeatButton>
                                                                    <Track.Thumb>
                                                                        <Thumb Focusable="False">
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                                    <Border x:Name="ThumbBorder"
                                                                                            Background="#8b8b8b"
                                                                                            CornerRadius="3"
                                                                                            SnapsToDevicePixels="True"/>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#636363"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsDragging" Value="True">
                                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#636363"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>
                                                                    <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                                      Focusable="False">
                                                                            <RepeatButton.Template>
                                                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                                    <Border Background="Transparent"/>
                                                                                </ControlTemplate>
                                                                            </RepeatButton.Template>
                                                                        </RepeatButton>
                                                                    </Track.IncreaseRepeatButton>
                                                                </Track>

                                                                <RepeatButton Grid.Row="2"
                                                                              Command="ScrollBar.LineDownCommand"
                                                                              Focusable="False">
                                                                    <RepeatButton.Template>
                                                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                            <Border Background="Transparent">
                                                                                <Path x:Name="ArrowDown"
                                                                                      Data="M 0 0 L 6 0 L 3 3 Z"
                                                                                      Fill="#8b8b8b"
                                                                                      Stretch="Fill"
                                                                                      Width="6"
                                                                                      Height="3"
                                                                                      Margin="0,0,0,-6"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Bottom"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ArrowDown" Property="Fill" Value="#636363"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </RepeatButton.Template>
                                                                </RepeatButton>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Resources>
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="{x:Type TextBox}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Background="{TemplateBinding Background}"
                                                              Focusable="False"
                                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Border>

                                <!--
                                    控制台底部操作小块：PS 高 92px、横向间距 9px、与上方控制台大块间距 9px。
                                    横向 5 块 + 4 gap 需精确铺满 1072 DIP（1608 PS px）：
                                      两侧瓦片 315 PS px（210 DIP），中间 3 块 314 PS px（209.333 DIP），gap 9 PS px（6 DIP）；
                                    5×宽度 + 4×gap = 210 + 3×209.333 + 210 + 4×6 = 1072 DIP ✓（与右边缘对齐）。
                                    垂直：Canvas.Top = 32 + 720 + 6 = 758 DIP；高度 61.33 DIP（92 PS px）保持不变。
                                -->
                                <!--
                                    ConsoleActionTile01：改用与关于页 5 按钮相同的悬浮内描边效果。
                                    - 移除共享 Style ConsoleActionTileBorderStyle（该 Style 仍被 Tile02~05 使用，保持不动）。
                                    - 常态白底、无描边；悬浮时色块内出现 2 物理像素 #CCD0D3 描边，无浅黄背景。
                                    - Width=210 / Height=61.33 / CornerRadius=8 保持不变；点击事件、文字、字号保持不变。
                                -->
                                <Border x:Name="ConsoleActionTile01"
                                        Canvas.Left="48"
                                        Canvas.Top="792"
                                        Width="210"
                                        Height="61.33"
                                        Background="{DynamicResource ConsoleTileBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ConsoleActionTile01_MouseLeftButtonUp"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <TextBlock Text="📋 复制日志"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource ConsoleTileTextBrush}"/>
                                        <Border Margin="0"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ConsoleActionTile01}" Value="True">
                                                            <Setter Property="BorderThickness" Value="1.33"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ConsoleTileHoverBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ConsoleActionTile02：同 Tile01 悬浮内描边效果 -->
                                <Border x:Name="ConsoleActionTile02"
                                        Canvas.Left="264"
                                        Canvas.Top="792"
                                        Width="209.333"
                                        Height="61.33"
                                        Background="{DynamicResource ConsoleTileBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ConsoleActionTile02_MouseLeftButtonUp"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <TextBlock Text="📤 导出日志"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource ConsoleTileTextBrush}"/>
                                        <Border Margin="0"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ConsoleActionTile02}" Value="True">
                                                            <Setter Property="BorderThickness" Value="1.33"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ConsoleTileHoverBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ConsoleActionTile03：同 Tile01 悬浮内描边效果 -->
                                <Border x:Name="ConsoleActionTile03"
                                        Canvas.Left="479.333"
                                        Canvas.Top="792"
                                        Width="209.333"
                                        Height="61.33"
                                        Background="{DynamicResource ConsoleTileBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ConsoleActionTile04_MouseLeftButtonUp"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <TextBlock Text="🔁 重新启动"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource ConsoleTileTextBrush}"/>
                                        <Border Margin="0"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ConsoleActionTile03}" Value="True">
                                                            <Setter Property="BorderThickness" Value="1.33"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ConsoleTileHoverBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ConsoleActionTile04：同 Tile01 悬浮内描边效果 -->
                                <Border x:Name="ConsoleActionTile04"
                                        Canvas.Left="694.667"
                                        Canvas.Top="792"
                                        Width="209.333"
                                        Height="61.33"
                                        Background="{DynamicResource ConsoleTileBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ConsoleActionTile03_MouseLeftButtonUp"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <TextBlock Text="⏹️ 停止运行"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource ConsoleTileTextBrush}"/>
                                        <Border Margin="0"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ConsoleActionTile04}" Value="True">
                                                            <Setter Property="BorderThickness" Value="1.33"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ConsoleTileHoverBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ConsoleActionTile05：同 Tile01 悬浮内描边效果；内容层为三层叠加图标 + 文字 StackPanel，包在外层 Grid 内。 -->
                                <Border x:Name="ConsoleActionTile05"
                                        Canvas.Left="910"
                                        Canvas.Top="792"
                                        Width="210"
                                        Height="61.33"
                                        Background="{DynamicResource ConsoleTileBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ConsoleActionTile05_MouseLeftButtonUp"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <!--
                                            "开始运行" 图标：三层叠加，视觉与 ⏹️ 停止按钮完全统一。
                                            底层 ⏹️（FontSize=20）提供外描边圆角矩形外壳；
                                            中层 14×14 DIP（21 PS px）遮罩，引用 ConsoleTileBrush 与按钮底色同源
                                              （浅色白 / 深色 #2B2B2B），遮掉 ⏹️ 内部实心块且永不与底色脱节；
                                            顶层矢量三角（Path）完全落入遮罩内，露出即为"播放"语义。
                                        -->
                                        <Grid VerticalAlignment="Center"
                                              Margin="0,0,4,0">
                                            <TextBlock Text="⏹️"
                                                       FontSize="20"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource ConsoleTileTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Border Width="14"
                                                    Height="14"
                                                    Background="{DynamicResource ConsoleTileBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            <!--
                                                顶层播放三角：改用矢量 Path 替代 ▶️ emoji，摆脱字体依赖。
                                                · 等腰三角形（宽略窄于标准 √3/2 比例，视觉平衡）。
                                                · 尺寸：高 12 DIP（=18 PS px）× 宽 10 DIP（=15 PS px）。
                                                · 顶点：左上(0,0) → 右中点(10,6) → 左下(0,12)，几何对称。
                                                · Margin 视觉微调：右 1 PS = 0.67 DIP，下 1.5 PS = 1 DIP
                                                  （抵消 ⏹️ 内部方块的视觉锚点偏移，使播放键视觉居中）。
                                                · Fill 引用 ConsoleTileTextBrush，与按钮内其它文字/emoji 同色
                                                  （浅色 #1F1F1F / 深色白）；不受 Y/S 字体切换影响。
                                            -->
                                            <Path Fill="{DynamicResource ConsoleTileTextBrush}"
                                                  Width="10"
                                                  Height="12"
                                                  Stretch="Fill"
                                                  Data="M 0,0 L 10,6 L 0,12 Z"
                                                  Margin="0.67,1,0,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="开始运行"
                                                   FontSize="20"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource ConsoleTileTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                        <Border Margin="0"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ConsoleActionTile05}" Value="True">
                                                            <Setter Property="BorderThickness" Value="1.33"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ConsoleTileHoverBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- 执行记录页：显示最近 7 天 n8n production Executions，缓存优先，后台同步。 -->
                        <Grid x:Name="ExecutionPage"
                              Visibility="Collapsed">
                            <Canvas x:Name="ExecutionPageCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock x:Name="ExecutionRecordsTitleText"
                                           Canvas.Left="48"
                                           Canvas.Top="10"
                                           Height="20"
                                           Text="执行记录 (Executions)"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           LineHeight="20"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource SettingsHeadingBrush}"/>

                                <TextBlock x:Name="ExecutionRecordsStatusText"
                                           Canvas.Left="252"
                                           Canvas.Top="13.33"
                                           Width="650"
                                           Height="16"
                                           Text="正在读取缓存..."
                                           FontSize="13"
                                           Foreground="#80000000"
                                           TextTrimming="CharacterEllipsis"/>

                                <Border x:Name="ExecutionRecordsRefreshTile"
                                        Canvas.Left="1094"
                                        Canvas.Top="6"
                                        Width="26"
                                        Height="26"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ExecutionRecordsRefreshTile_MouseLeftButtonUp"
                                        ToolTip="手动刷新概览和执行记录"
                                        SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource ExecutionRefreshTileBrush}"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="True">
                                        <TextBlock Text="🔄"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="18"
                                                   FontWeight="Normal"
                                                   Foreground="#0080FF"
                                                   Margin="0,-2,0,0"/>
                                    </Border>
                                </Border>

                                <Border x:Name="ExecutionRecordsPanel"
                                        Canvas.Left="48"
                                        Canvas.Top="38"
                                        Width="1072"
                                        Height="815.33"
                                        Background="{DynamicResource ExecutionTablePanelBrush}"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                     <!-- 内 Grid 下边距 16 → 11.33：与 Border 高度 820→815.33 的收缩量 (4.67 DIP) 抵消，
                                          确保 ScrollViewer 视口高度仍为 755 DIP，滑块显示阈值与改前一致，避免 Auto 模式下临界隐藏。 -->
                                     <Grid Margin="18,0,18,11.33">
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="48"/>
                                             <RowDefinition Height="1"/>
                                             <RowDefinition Height="*"/>
                                         </Grid.RowDefinitions>

                                        <Grid x:Name="ExecutionRecordsHeaderGrid"
                                              Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="356"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                             <Border x:Name="ExecutionRecordsWorkflowHeaderFilterHost"
                                                     Grid.Column="0"
                                                     Height="48"
                                                     Background="Transparent"
                                                     Cursor="Hand"
                                                     Tag="Workflow"
                                                     VerticalAlignment="Center"
                                                     MouseEnter="ExecutionRecordsWorkflowFilterHoverArea_MouseEnter"
                                                     MouseLeave="ExecutionRecordsWorkflowFilterHoverArea_MouseLeave"
                                                    MouseLeftButtonUp="ExecutionSortHeader_MouseLeftButtonUp">
                                                 <!--
                                                     单-Cell 三层叠加：文字始终锁定 VerticalAlignment=Center，不受 ∧/∨ 显隐影响。
                                                     Up:  Top,    Margin="0,6,0,0"  → V 形顶边距表头行顶 6 DIP（9 PS px）
                                                     Down: Bottom, Margin="0,0,0,6" → V 形底边距表头行底/分割线 6 DIP（9 PS px）
                                                 -->
                                                 <Grid x:Name="ExecutionRecordsWorkflowHeaderTextAnchor"
                                                       VerticalAlignment="Stretch"
                                                       HorizontalAlignment="Center">
                                                     <Polyline x:Name="ExecutionRecordsSortIndicator_Workflow_Up"
                                                               Points="0,4 6,0 12,4"
                                                               Stroke="#9E9E9E"
                                                               StrokeThickness="1.33"
                                                               StrokeStartLineCap="Round"
                                                               StrokeEndLineCap="Round"
                                                               StrokeLineJoin="Round"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"
                                                               Margin="0,6,0,0"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed"/>
                                                     <StackPanel Orientation="Horizontal"
                                                                 VerticalAlignment="Center">
                                                          <TextBlock Text="Workflow"
                                                                     FontSize="16"
                                                                     FontWeight="SemiBold"
                                                                     Foreground="{DynamicResource ExecutionHeaderTextBrush}"
                                                                    VerticalAlignment="Center"/>
                                                     </StackPanel>
                                                     <Polyline x:Name="ExecutionRecordsSortIndicator_Workflow_Down"
                                                               Points="0,0 6,4 12,0"
                                                               Stroke="#9E9E9E"
                                                               StrokeThickness="1.33"
                                                               StrokeStartLineCap="Round"
                                                               StrokeEndLineCap="Round"
                                                               StrokeLineJoin="Round"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Bottom"
                                                               Margin="0,0,0,6"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed"/>
                                                 </Grid>
