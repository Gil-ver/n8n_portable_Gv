                                        <Border Grid.Row="1" Background="{DynamicResource ExecutionHeaderDividerBrush}"/>

                                        <ScrollViewer x:Name="ExecutionRecordsScrollViewer"
                                                      Grid.Row="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Focusable="False"
                                                      FocusVisualStyle="{x:Null}"
                                                      ScrollChanged="ExecutionRecordsScrollViewer_ScrollChanged">
                                            <ScrollViewer.Resources>
                                                <!-- 执行记录页 ScrollBar：复刻自控制台 (ConsoleOutputTextBox) 内部样式，
                                                     宽度 6 DIP、Margin="13,0,-13,0"、顶/底 7 DIP 三角、Thumb 圆角 3；
                                                     默认 #8b8b8b，悬浮/拖拽 #636363；箭头三角同色。
                                                     仅作用于当前 ScrollViewer，不影响其它任何 ScrollBar。 -->
                                                <Style TargetType="{x:Type ScrollBar}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Width" Value="6"/>
                                                    <Setter Property="MinWidth" Value="6"/>
                                                    <Setter Property="Margin" Value="13,0,-13,0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                                <Grid Background="Transparent" SnapsToDevicePixels="True">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="7"/>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="7"/>
                                                                    </Grid.RowDefinitions>

                                                                    <RepeatButton Grid.Row="0"
                                                                                  Command="ScrollBar.LineUpCommand"
                                                                                  Focusable="False">
                                                                        <RepeatButton.Template>
                                                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                                <Border Background="Transparent">
                                                                                    <Path x:Name="ArrowUp"
                                                                                          Data="M 0 3 L 6 3 L 3 0 Z"
                                                                                          Fill="#8b8b8b"
                                                                                          Stretch="Fill"
                                                                                          Width="6"
                                                                                          Height="3"
                                                                                          Margin="0,-6,0,0"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Top"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="ArrowUp" Property="Fill" Value="#636363"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </RepeatButton.Template>
                                                                    </RepeatButton>

                                                                    <Track x:Name="PART_Track"
                                                                           Grid.Row="1"
                                                                           IsDirectionReversed="True">
                                                                        <Track.DecreaseRepeatButton>
                                                                            <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                                          Focusable="False">
                                                                                <RepeatButton.Template>
                                                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                                        <Border Background="Transparent"/>
                                                                                    </ControlTemplate>
                                                                                </RepeatButton.Template>
                                                                            </RepeatButton>
                                                                        </Track.DecreaseRepeatButton>
                                                                        <Track.Thumb>
                                                                            <Thumb Focusable="False">
                                                                                <Thumb.Template>
                                                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                                                        <Border x:Name="ThumbBorder"
                                                                                                Background="#8b8b8b"
                                                                                                CornerRadius="3"
                                                                                                SnapsToDevicePixels="True"/>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#636363"/>
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsDragging" Value="True">
                                                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#636363"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Thumb.Template>
                                                                            </Thumb>
                                                                        </Track.Thumb>
                                                                        <Track.IncreaseRepeatButton>
                                                                            <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                                          Focusable="False">
                                                                                <RepeatButton.Template>
                                                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                                        <Border Background="Transparent"/>
                                                                                    </ControlTemplate>
                                                                                </RepeatButton.Template>
                                                                            </RepeatButton>
                                                                        </Track.IncreaseRepeatButton>
                                                                    </Track>

                                                                    <RepeatButton Grid.Row="2"
                                                                                  Command="ScrollBar.LineDownCommand"
                                                                                  Focusable="False">
                                                                        <RepeatButton.Template>
                                                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                                <Border Background="Transparent">
                                                                                    <Path x:Name="ArrowDown"
                                                                                          Data="M 0 0 L 6 0 L 3 3 Z"
                                                                                          Fill="#8b8b8b"
                                                                                          Stretch="Fill"
                                                                                          Width="6"
                                                                                          Height="3"
                                                                                          Margin="0,0,0,-6"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Bottom"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="ArrowDown" Property="Fill" Value="#636363"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </RepeatButton.Template>
                                                                    </RepeatButton>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ScrollViewer.Resources>
                                            <StackPanel x:Name="ExecutionRecordsListPanel"
                                                        Focusable="False"
                                                        FocusVisualStyle="{x:Null}"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- 设置页：Windows 11 风格长条设置项，仅包含第一版确认的 6 项。 -->
                        <Grid x:Name="SettingPage"
                              Visibility="Collapsed">
                            <!-- 设置项总高 > 可视区，包一层 ScrollViewer 支持鼠标滚轮滚动；
                                 VerticalScrollBarVisibility="Hidden" 使滑块不可见但滚轮仍生效。 -->
                             <ScrollViewer x:Name="SettingPageScrollViewer"
                                           VerticalScrollBarVisibility="Hidden"
                                           HorizontalScrollBarVisibility="Disabled"
                                           CanContentScroll="False"
                                           PanningMode="VerticalOnly"
                                           Focusable="False">
                            <Canvas x:Name="SettingPageCanvas"
                                    Width="1168"
                                    Height="930"
                                    HorizontalAlignment="Stretch">
                                <TextBlock x:Name="SettingsTitleText"
                                           Canvas.Left="48"
                                           Canvas.Top="10"
                                           Height="20"
                                           Text="设置 (Settings)"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           LineHeight="20"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource SettingsHeadingBrush}"/>

                                <!--
                                    设置页标题下的横分割线：宽度与下方设置卡片同宽（1072 DIP），高 1.33 DIP（= 2 PS px）。
                                    颜色走主题键 SettingsDividerBrush（浅 #14000000 / 深 #3F3F3F），
                                    与执行记录页表头、洞察卡片、启动页竖分割线同一套取值；详见资源区该键的注释块。
                                    ★ 改造前浅 #E6E6E6 / 深 #2B2B2B，本轮为统一分割线方案而有意调整（非回归）。
                                    ★ 本元素无 Opacity，无需像启动页两根竖线那样删除叠加淡化。
                                -->
                                <Border Canvas.Left="48"
                                        Canvas.Top="38"
                                        Width="1072"
                                        Height="1.33"
                                        Background="{DynamicResource SettingsDividerBrush}"
                                        SnapsToDevicePixels="True"/>

                                <!--
                                    ===============================================================
                                    设置页分类排版规则（PS px → DIP，÷1.5）
                                    ===============================================================
                                    · 分类名字号: 24 PS → 16 DIP，字重 Normal，颜色 #1F1F1F，行高锁 16 DIP
                                    · 分类名 → 该组第一张卡片顶: 12 PS → 8 DIP（视觉锚定，不占布局）
                                    · 分类间距（卡片↔卡片）: 75 PS → 50 DIP
                                    · 组内卡片间距: 4 DIP
                                    · 首个分类和上方分割线的距离: 与分类间距一致 = 50 DIP
                                    · 单张设置卡片高度: 108 PS → 72 DIP
                                    · 分类名 = 浮标: 独立 Canvas.Top 定位，IsHitTestVisible=False；
                                      它的字号/宽度/是否存在都不影响卡片位置。卡片位置只由两种 Margin.Top 决定：
                                        - 组内后续卡片: 4 DIP
                                        - 每组第一张卡片（非首组）: 50 DIP
                                        - 首组第一张卡片: 无 Margin
                                    · StackPanel Canvas.Top = 分割线底 39.33 + 50 = 89.33 DIP
                                    · 分类名 Canvas.Top 计算公式:
                                        = StackPanel.Canvas.Top(89.33) + 该组第一张卡片相对 Y − 8 − 16
                                      当前 4 组（时区并入"运行计划"作为第 2 张）:
                                        个性化   → 第 1 张(Y=0)   → 89.33 + 0   − 24 = 65.33
                                        系统交互 → 第 4 张(Y=274) → 89.33 + 274 − 24 = 339.33
                                        运行计划 → 第 6 张(Y=472) → 89.33 + 472 − 24 = 537.33
                                        恢复     → 第 9 张(Y=746) → 89.33 + 746 − 24 = 811.33
                                    · 后续新增分类/卡片时，按同一公式重新计算各分类名 Canvas.Top 即可。
                                    ===============================================================
                                -->
                                <TextBlock x:Name="SettingsCategoryPersonalization"
                                           Canvas.Left="50"
                                           Canvas.Top="65.33"
                                           Text="个性化 (Personalization)"
                                           FontSize="16"
                                           FontWeight="Normal"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource SettingsHeadingBrush}"
                                           IsHitTestVisible="False"/>
                                <TextBlock x:Name="SettingsCategorySystemIntegration"
                                           Canvas.Left="50"
                                           Canvas.Top="339.33"
                                           Text="系统交互 (System)"
                                           FontSize="16"
                                           FontWeight="Normal"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource SettingsHeadingBrush}"
                                           IsHitTestVisible="False"/>
                                <TextBlock x:Name="SettingsCategoryRunPlan"
                                           Canvas.Left="50"
                                           Canvas.Top="537.33"
                                           Text="运行计划 (Schedule)"
                                           FontSize="16"
                                           FontWeight="Normal"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource SettingsHeadingBrush}"
                                           IsHitTestVisible="False"/>
                                <TextBlock x:Name="SettingsCategoryReset"
                                           Canvas.Left="50"
                                           Canvas.Top="811.33"
                                           Text="恢复 (Reset)"
                                           FontSize="16"
                                           FontWeight="Normal"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource SettingsHeadingBrush}"
                                           IsHitTestVisible="False"/>

                                <StackPanel Canvas.Left="48"
                                            Canvas.Top="89.33"
                                            Width="1072">
                                    <Border x:Name="SettingsScaleRow"
                                            Height="72"
                                            Background="{DynamicResource SettingsCardBrush}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <Grid Margin="24,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="250"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="缩放 (Scale)"
                                                           FontSize="16"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource SettingsHeadingBrush}"/>
                                                <TextBlock Text="缩放窗口以适应你的屏幕。(Scale the window to fit your screen.)"
                                                           Margin="0,6,0,0"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SettingsSubTextBrush}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="SettingsScaleComboBox"
                                                      Grid.Column="1"
                                                      Width="207"
                                                      Height="36"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Padding="10,4,10,4"
                                                      FontSize="13"
                                                      FocusVisualStyle="{x:Null}"
                                                      SelectionChanged="SettingsScaleComboBox_SelectionChanged">
                                                <!-- 档位固定整十百分比阶梯：100% / 75% / 60% / 50% / 40%，对应窗口物理尺寸
                                                     2160×1440 / 1620×1080 / 1296×864 / 1080×720 / 864×576。
                                                     Tag 必须与托盘「比例切换」和 ComputeAutoScale() 的返回值一一对应，否则会错显 100%。 -->
                                                <ComboBoxItem Content="100%" Tag="1"/>
                                                <ComboBoxItem Content="75%" Tag="0.75"/>
                                                <ComboBoxItem Content="60%" Tag="0.6"/>
                                                <ComboBoxItem Content="50%" Tag="0.5"/>
                                                <ComboBoxItem Content="40%" Tag="0.4"/>
