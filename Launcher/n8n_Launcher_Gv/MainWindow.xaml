                        <!-- 关于页：程序简介、官方链接、致谢/免责声明，以及本地教程提示。 -->
                        <Grid x:Name="AboutPage"
                              Visibility="Collapsed">
                            <Canvas x:Name="AboutPageCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <!--
                                    关于页主卡片：位置与执行记录页 ExecutionRecordsPanel 顶部对齐
                                    (Canvas.Left=48 / Canvas.Top=38)，宽度 1072 DIP（PS 1608px ÷ 1.5）。
                                    高度 380 DIP（PS 570px ÷ 1.5），比执行记录大卡片短，仅占页面上半区。
                                    白底 + 8 DIP 圆角，与其它主卡片视觉统一。当前为空壳，等待后续内容注入。
                                -->
                                <!--
                                    图片以 PS "剪切蒙版" 语义嵌入卡片：
                                    · about.png 原始 1608×320 PS px → 卡片宽 1072 DIP 等比缩放后高 213.33 DIP；
                                    · 卡片高 380 DIP，图片上对齐、水平居中，底部 166.67 DIP 保留白底；
                                    · WPF 中 Border.CornerRadius 不裁剪 Child，因此显式在内部 Grid 上加
                                      RectangleGeometry(RadiusX/Y=8) 的 Clip，使图片顶部两个角随卡片圆角剪切。
                                -->
                                <Border x:Name="AboutMainPanel"
                                        Canvas.Left="48"
                                        Canvas.Top="38"
                                        Width="1072"
                                        Height="333.33"
                                        Background="{DynamicResource SettingsCardBrush}"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,1072,333.33" RadiusX="8" RadiusY="8"/>
                                        </Grid.Clip>
                                        <Image x:Name="AboutMainPanelImage"
                                               Source="icon/about.png"
                                               Width="1072"
                                               Height="213.33"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Stretch="Fill"
                                               SnapsToDevicePixels="True"/>
                                        <!--
                                            中英文副文案组：包在同一个 StackPanel 里，中英间距永久锁死，
                                            以后要整体上下移动，只改本 StackPanel 的 Margin.Top 一处。
                                            · 组顶 Margin.Top = 207.33 DIP（当前中文视觉位置）
                                            · 中英间距 = 英文 Margin.Top = 12 DIP（= 18 PS px），永不脱钩
                                        -->
                                        <StackPanel x:Name="AboutHeaderSubtitleGroup"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Margin="0,229,0,0"
                                                    IsHitTestVisible="False">
                                            <TextBlock x:Name="AboutHeaderSubtitleText"
                                                       HorizontalAlignment="Center"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource AboutHeaderSubtitleBrush}"
                                                       TextAlignment="Center"
                                                       LineHeight="24"
                                                       LineStackingStrategy="MaxHeight">
                                                <Run Text="本程序是n8n_portable_Gv的专属组件，仅随此便携包发布。"/>
                                                <LineBreak/>
                                                <Run Text="方便在Windows上运行与管理n8n，让个人用户也能轻松使用。"/>
                                            </TextBlock>
                                            <TextBlock x:Name="AboutHeaderSubtitleEnglishText"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,3,0,0"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource AboutHeaderSubtitleEnglishBrush}"
                                                       TextAlignment="Center"
                                                       LineHeight="16"
                                                       LineStackingStrategy="MaxHeight">
                                                <Run Text="This program is a dedicated component of n8n_portable_Gv and is distributed only with this portable package."/>
                                                <LineBreak/>
                                                <Run Text="It makes it easy to run and manage n8n on Windows for individual users."/>
                                            </TextBlock>
                                        </StackPanel>
                                        <!--
                                            启动器版本文字（叠加在图片右下角）：
                                            · 设计稿：字号 24 PS→16 DIP；距图片右侧 15 PS→10 DIP；距图片底部 12 PS→8 DIP。
                                            · 图片区高 213.33 DIP → TextBlock Margin.Top = 213.33 - 16 - 8 = 189.33 DIP。
                                            · Text 值由 C# 构造函数中赋值 LAUNCHER_VERSION，与底栏 StatusText / 配置文件同源。
                                        -->
                                        <TextBlock x:Name="AboutHeaderVersionText"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,189.33,10,0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   IsHitTestVisible="False"
                                                   Text=""/>
                                    </Grid>
                                </Border>

                                <!--
                                    关于页大卡片下方五张按钮：
                                    · 尺寸/间距完全复刻控制台底部 ConsoleActionTile01~05：
                                      两端 210 DIP，中间 3 张 209.33 DIP，横向间距 6 DIP，高 61.33 DIP。
                                    · 大卡片 Top=38 / Height=380 → 底端 418 DIP；间距 6 DIP → Canvas.Top = 424 DIP。
                                    · Left 与大卡片左对齐 = 48 DIP。
                                    · 使用 ConsoleActionTileBorderStyle（白底 8 DIP 圆角 + 悬浮浅黄）。
                                    · 空壳，无 x:Name / 无 Click / 无文本，等待后续内容注入。
                                -->
                                <!--
                                    关于页 5 按钮：高度对齐设置页卡片（72 DIP），无悬浮反馈。
                                    · Border: White / #E8EBED 1.33 边 / CornerRadius=8
                                    · 内部 StackPanel: Margin=24,0 / VerticalAlignment=Center
                                      - 主文字: 16 DIP / #1F1F1F
                                      - 副文字: 13 DIP / #80000000 / Margin.Top=6
                                    · 文本占位为 "n8n"，等待后续内容注入。
                                -->
                                <Border x:Name="AboutSiteN8nOfficialButton"
                                        Canvas.Left="479.333"
                                        Canvas.Top="392"
                                        Width="209.333"
                                        Height="72"
                                        Background="{DynamicResource SettingsCardBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        Tag="https://n8n.io/"
                                        MouseLeftButtonUp="AboutSiteButton_MouseLeftButtonUp"
                                        SnapsToDevicePixels="True">
                                    <!--
                                        外层 Grid 默认 Stretch，完全铺满 Border 内部 210×72 DIP。
                                        用于承载 内容层(居中) + 悬浮描边层(撑满色块) 两个兄弟节点。
                                    -->
                                    <Grid>
                                        <!-- 内容层：图标 + 主/副文字，垂直居中 -->
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{StaticResource HyperlinkIconImage}"
                                                   Width="40" Height="40"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="n8n官网" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource SettingsHeadingBrush}"/>
                                                <TextBlock Text="n8n Homepage" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource SettingsSubTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <!--
                                            悬浮内描边（仅本按钮）——改用 Border 承担描边：
                                            - 该 Border 是外层 Grid 兄弟节点，Margin=0 完全撑满色块 210×72。
                                            - WPF Border.BorderThickness 严格"向内"绘制（不像 Rectangle.Stroke 居中）：
                                              → BorderThickness=1.33 DIP = 2 物理像素，整条描边完全在色块内部；
                                              → 描边外沿贴色块外沿，内沿距色块外沿 2 物理像素；
                                              → 无外露，也无 1 物理像素白色间隙。
                                            - CornerRadius=8 与色块 CornerRadius 完全一致，圆角处不断口。
                                            - IsHitTestVisible=False 不拦截点击；Background=Transparent 不遮挡内容层。
                                            - 常态 BorderThickness=0 + BorderBrush=Transparent；DataTrigger 通过
                                              ElementName=AboutSiteN8nOfficialButton 直接绑定外层色块 Border 的
                                              IsMouseOver，悬浮时切 BorderThickness=1.33 + BorderBrush=#CCD0D3。
                                            - ★用 ElementName 而非 AncestorLevel：避免"数几层"的歧义，
                                              直接按 x:Name 命中外层色块 Border，绑定关系最稳。
                                            - ★禁止修改色块 Width/Height/CornerRadius；描边必须留在色块内部。
                                        -->
                                        <!--
                                            ★依赖属性优先级坑：本地属性(Border 元素上直接写的 XAML) 优先级 > Style Trigger Setter。
                                              因此 BorderThickness/BorderBrush 的常态值必须放在 Style Setter 里，
                                              不能作为本地属性写在 Border 元素上，否则 Trigger 永远无法覆盖 → 悬浮不显示描边。
                                            - Style Setter (常态 BorderThickness=0 / BorderBrush=Transparent)
                                              与 DataTrigger Setter (悬浮 BorderThickness=1.33 / BorderBrush=#CCD0D3)
                                              同为 Style 级优先级，Trigger 触发时正常覆盖 Setter。
                                        -->
                                        <Border Margin="0"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=AboutSiteN8nOfficialButton}" Value="True">
                                                            <Setter Property="BorderThickness" Value="1.33"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ConsoleTileHoverBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border x:Name="AboutSiteN8nGithubButton"
                                        Canvas.Left="264"
                                        Canvas.Top="392"
                                        Width="209.333"
                                        Height="72"
                                        Background="{DynamicResource SettingsCardBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        Tag="https://github.com/n8n-io/n8n"
                                        MouseLeftButtonUp="AboutSiteButton_MouseLeftButtonUp"
                                        SnapsToDevicePixels="True">
                                    <!-- 悬浮描边同 AboutSiteN8nOfficialButton；DataTrigger ElementName 换成本按钮 x:Name。 -->
                                    <Grid>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{StaticResource HyperlinkIconImage}"
                                                   Width="40" Height="40"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="n8n 项目仓库" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource SettingsHeadingBrush}"/>
                                                <TextBlock Text="n8n Project Repository" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource SettingsSubTextBrush}"/>
